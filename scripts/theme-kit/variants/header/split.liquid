{%- liquid
  assign menu = section.settings.menu
  assign half = menu.links.size | plus: 1 | divided_by: 2
-%}
<header class="k-header k-header--split{% if section.settings.sticky %} k-header--sticky{% endif %}{% if section.settings.transparent_home and template.name == 'index' %} k-header--over{% endif %}" data-header>
  <div class="page-width k-header__inner">
    <div class="k-header__start">
      {% render 'header-drawer', menu: menu %}
    </div>
    {% render 'header-menu', menu: menu, from: 0, to: half, modifier: 'k-menu--left' %}
    {% render 'header-logo' %}
    {% render 'header-menu', menu: menu, from: half, modifier: 'k-menu--right' %}
    <div class="k-header__end">
      {% render 'header-icons', parts: 'search,account,bag' %}
    </div>
  </div>
  {% render 'header-search' %}
</header>

