{%- liquid
  assign current = product.selected_or_first_available_variant
  assign first_image = current.featured_image | default: product.featured_image
  assign first_alt = first_image.alt | default: product.title
  assign first_focal = ''
  if first_image.presentation.focal_point != blank
    assign first_focal = 'object-position: ' | append: first_image.presentation.focal_point
  endif
  assign s = section.settings
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
-%}
<div class="page-width k-pdp k-pdp--@PDP@" data-product-section data-section-id="{{ section.id }}">
  {%- if settings.show_breadcrumbs -%}{% render 'breadcrumbs', collection: collection, product: product %}{%- endif -%}
  <div class="k-pdp__grid">
    {% render 'product-gallery', product: product, first_image: first_image, first_alt: first_alt, first_focal: first_focal, show_badge: s.show_badge %}
    <div class="k-info">
      {%- if s.show_vendor and product.vendor != blank -%}<p class="k-info__brand">{{ product.vendor | escape }}</p>{%- endif -%}
      <h1 class="k-info__title">{{ product.title | escape }}</h1>
      <div class="k-info__price" data-product-price>{% render 'price', product: product, variant: current, class: 'k-price--large' %}</div>
      <p class="k-info__stock k-stock {% if current.available %}k-stock--in{% else %}k-stock--out{% endif %}" data-stock role="status"><span data-stock-label>{% if current.available %}{{ 'products.in_stock' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span></p>
      {%- if settings.stock_counter -%}
        {%- assign low_limit = settings.stock_threshold | default: 10 -%}
        <p class="k-lowstock" data-lowstock data-limit="{{ low_limit }}" data-template="{{ 'products.low_stock' | t: count: '[count]' | escape }}" role="status"{% unless current.available and current.inventory_management != blank and current.inventory_quantity > 0 and current.inventory_quantity <= low_limit %} hidden{% endunless %}>{{ 'products.low_stock' | t: count: current.inventory_quantity }}</p>
        <script type="application/json" data-stock-json>{ {%- for variant in product.variants -%}"{{ variant.id }}": {% if variant.inventory_management != blank %}{{ variant.inventory_quantity | default: 0 }}{% else %}-1{% endif %}{% unless forloop.last %}, {% endunless %}{%- endfor -%} }</script>
      {%- endif -%}
      {%- if s.show_summary and product.description != blank -%}
        <div class="k-info__summary rte">{{ product.description | strip_html | truncatewords: 32 }}</div>
      {%- endif -%}

      {%- form 'product', product, id: 'product-form', class: 'k-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            {%- assign option_key = option.name | downcase | strip -%}
            {%- assign as_swatch = false -%}
            {%- if settings.swatches_enabled and swatch_names contains option_key -%}{%- assign as_swatch = true -%}{%- endif -%}
            <fieldset class="k-option{% if as_swatch %} k-option--swatch{% endif %}" data-option-index="{{ forloop.index0 }}">
              <legend class="k-legend">{{ option.name | escape }}<span class="k-legend__value" data-option-value>{{ option.selected_value | escape }}</span></legend>
              <div class="k-option__values">
                {%- for value in option.values -%}
                  {%- assign checked = false -%}
                  {%- if option.selected_value == value -%}{%- assign checked = true -%}{%- endif -%}
                  <input type="radio" class="k-option__input" id="{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}"{% if checked %} checked{% endif %}>
                  {%- if as_swatch -%}
                    <label class="k-option__label k-option__label--swatch" for="{{ section.id }}-{{ option.position }}-{{ forloop.index }}" style="{% render 'swatch-style', name: value %}" title="{{ value | escape }}"><span class="visually-hidden">{{ value | escape }}</span></label>
                  {%- else -%}
                    <label class="k-option__label" for="{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{{ value | escape }}</label>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endunless -%}

        {% render 'purchase-options', product: product, variant: current, id_prefix: section.id %}

        {%- if product.gift_card -%}
          <div class="field">
            <label for="{{ section.id }}-gc-email">{{ 'products.gift_card.recipient_email' | t }}</label>
            <input id="{{ section.id }}-gc-email" type="email" name="properties[Recipient email]" autocomplete="off">
          </div>
          <div class="field">
            <label for="{{ section.id }}-gc-name">{{ 'products.gift_card.recipient_name' | t }}</label>
            <input id="{{ section.id }}-gc-name" type="text" name="properties[Recipient name]" autocomplete="off">
          </div>
          <div class="field">
            <label for="{{ section.id }}-gc-message">{{ 'products.gift_card.message' | t }}</label>
            <textarea id="{{ section.id }}-gc-message" name="properties[Message]" rows="3" maxlength="200"></textarea>
          </div>
        {%- endif -%}

        <div class="k-form__row">
          <div class="k-qty k-qty--lg">
            <label class="visually-hidden" for="{{ section.id }}-qty">{{ 'products.quantity' | t }}</label>
            <button type="button" class="k-qty__btn" data-pdp-step="-1" aria-label="{{ 'products.decrease_quantity' | t }}">{% render 'icon', name: 'minus', size: 16 %}</button>
            <input class="k-qty__input" id="{{ section.id }}-qty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
            <button type="button" class="k-qty__btn" data-pdp-step="1" aria-label="{{ 'products.increase_quantity' | t }}">{% render 'icon', name: 'plus', size: 16 %}</button>
          </div>
          <button type="submit" class="button button--block" name="add" data-add-to-cart{% unless current.available %} disabled{% endunless %}>
            <span data-add-label>{% if current.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>
          </button>
        </div>
        <p class="k-form__message" role="status" aria-live="polite" data-form-message></p>
      {%- endform -%}

      {%- liquid
        assign has_benefits = false
        for block in section.blocks
          if block.type == 'benefit'
            assign has_benefits = true
          endif
        endfor
      -%}
      {%- if has_benefits -%}
        <ul class="k-benefits" role="list">
          {%- assign benefit_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              {%- assign benefit_index = benefit_index | plus: 1 -%}
              {%- assign text = block.settings.text -%}
              {%- if text == blank -%}{%- assign text = 'perks.default_' | append: benefit_index | append: '_text' | t -%}{%- endif -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 20 %} <span>{{ text | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="k-accordions">
        {%- if section.blocks.size == 0 and product.description != blank -%}
          <details class="k-fold" open><summary>{{ 'products.description' | t }} {% render 'icon', name: 'chevron-down', size: 18 %}</summary><div class="rte">{{ product.description }}</div></details>
        {%- endif -%}
        {%- assign accordion_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            {%- assign accordion_index = accordion_index | plus: 1 -%}
            {%- liquid
              assign heading = block.settings.heading
              assign body = block.settings.text
              if heading == blank
                assign heading = 'products.accordion_' | append: accordion_index | append: '_title' | t
              endif
            -%}
            <details class="k-fold" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
              <summary>{{ heading | escape }} {% render 'icon', name: 'chevron-down', size: 18 %}</summary>
              {%- if block.settings.show_description -%}<div class="rte">{{ product.description }}</div>{%- elsif body != blank -%}<div class="rte">{{ body }}</div>{%- else -%}<div class="rte"><p>{{ 'products.accordion_' | append: accordion_index | append: '_text' | t }}</p></div>{%- endif -%}
            </details>
          {%- elsif block.type == 'details' -%}
            {%- assign ingredients = product.metafields[block.settings.namespace][block.settings.key] -%}
            {%- if ingredients != blank -%}
              {%- assign ing_heading = block.settings.heading -%}
              {%- if ing_heading == blank -%}{%- assign ing_heading = 'products.details' | t -%}{%- endif -%}
              <details class="k-fold" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                <summary>{{ ing_heading | escape }} {% render 'icon', name: 'chevron-down', size: 18 %}</summary>
                <div class="rte">{{ ingredients | metafield_tag }}</div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/ld+json">{{ product | structured_data }}</script>
</div>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_product.settings.show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "t:sections.main_product.settings.show_summary",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "t:sections.main_product.settings.show_badge",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.main_product.blocks.benefit.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.main_product.blocks.benefit.settings.icon",
          "default": "leaf",
          "options": [
            {
              "value": "leaf",
              "label": "t:sections.main_product.blocks.benefit.options.icon.leaf"
            },
            {
              "value": "drop",
              "label": "t:sections.main_product.blocks.benefit.options.icon.drop"
            },
            {
              "value": "sparkle",
              "label": "t:sections.main_product.blocks.benefit.options.icon.sparkle"
            },
            {
              "value": "heart",
              "label": "t:sections.main_product.blocks.benefit.options.icon.heart"
            },
            {
              "value": "truck",
              "label": "t:sections.main_product.blocks.benefit.options.icon.truck"
            },
            {
              "value": "check",
              "label": "t:sections.main_product.blocks.benefit.options.icon.check"
            },
            {
              "value": "refresh",
              "label": "t:sections.main_product.blocks.benefit.options.icon.refresh"
            },
            {
              "value": "shield",
              "label": "t:sections.main_product.blocks.benefit.options.icon.shield"
            },
            {
              "value": "package",
              "label": "t:sections.main_product.blocks.benefit.options.icon.package"
            },
            {
              "value": "gift",
              "label": "t:sections.main_product.blocks.benefit.options.icon.gift"
            },
            {
              "value": "clock",
              "label": "t:sections.main_product.blocks.benefit.options.icon.clock"
            },
            {
              "value": "tag",
              "label": "t:sections.main_product.blocks.benefit.options.icon.tag"
            },
            {
              "value": "home",
              "label": "t:sections.main_product.blocks.benefit.options.icon.home"
            },
            {
              "value": "scissors",
              "label": "t:sections.main_product.blocks.benefit.options.icon.scissors"
            },
            {
              "value": "ruler",
              "label": "t:sections.main_product.blocks.benefit.options.icon.ruler"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.main_product.blocks.benefit.settings.text",
          "info": "t:sections.main_product.blocks.benefit.info.text"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "t:sections.main_product.blocks.accordion.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.accordion.settings.heading",
          "info": "t:sections.main_product.blocks.accordion.info.heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.main_product.blocks.accordion.settings.text"
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "label": "t:sections.main_product.blocks.accordion.settings.show_description",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:sections.main_product.blocks.accordion.settings.open",
          "default": false
        }
      ]
    },
    {
      "type": "details",
      "name": "t:sections.main_product.blocks.details.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.main_product.blocks.details.settings.heading",
          "info": "t:sections.main_product.blocks.details.info.heading"
        },
        {
          "type": "text",
          "id": "namespace",
          "label": "t:sections.main_product.blocks.details.settings.namespace",
          "default": "custom"
        },
        {
          "type": "text",
          "id": "key",
          "label": "t:sections.main_product.blocks.details.settings.key",
          "default": "details",
          "info": "t:sections.main_product.blocks.details.info.key"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "t:sections.main_product.blocks.details.settings.open",
          "default": false
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "benefit",
        "settings": {
          "icon": "leaf"
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "drop"
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "truck"
        }
      },
      {
        "type": "accordion",
        "settings": {
          "show_description": true,
          "open": true,
          "heading": ""
        }
      },
      {
        "type": "ingredients",
        "settings": {}
      },
      {
        "type": "accordion",
        "settings": {}
      }
    ]
  }
}
{% endschema %}
