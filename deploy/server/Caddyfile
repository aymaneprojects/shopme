# Caddy in front of ShopMe. Replace the domain and e-mail; the DNS A/AAAA record must point to this server.
# Multi-store is on by default: the storefront of the first store is served on this domain, the admin at /admin, and every
# other store on <handle>.shop.example.com. Add one wildcard DNS record: *.shop.example.com A <this server>.
# Certificates are issued on demand, only for hosts ShopMe says it serves.
{
	email you@example.com
	on_demand_tls {
		ask http://shopme:3000/__shopme/tls-ask
	}
}

shop.example.com {
	encode zstd gzip
	reverse_proxy shopme:3000
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy shopme:3000
}

http:// {
	redir https://{host}{uri} permanent
}
