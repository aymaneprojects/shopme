{
  "name": "shopme",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @shopme/server dev",
    "start": "pnpm --filter @shopme/server start",
    "seed": "pnpm --filter @shopme/core seed",
    "db:generate": "pnpm --filter @shopme/core db:generate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:postgres@localhost:5432/postgres} pnpm --filter @shopme/core --filter @shopme/migrate --filter @shopme/server --workspace-concurrency=1 test:pg",
    "typecheck": "turbo run typecheck",
    "e2e": "node e2e/run.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "theme-kit": "node scripts/theme-kit/build.mjs",
    "theme-previews": "node scripts/theme-previews.mjs",
    "theme-zip": "node scripts/theme-zip.mjs",
    "theme-checksums": "node scripts/theme-checksums.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3"
  }
}
