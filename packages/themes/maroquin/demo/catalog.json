  "homepage": {
    "en": {
      "hero": {
        "eyebrow": "Leather goods",
        "heading": "Leather that gets better with time",
        "text": "Bags, shoes and small leather goods in camel, black and cream. Full-grain hides, stitched by hand and made to be repaired, not replaced.",
        "button_label": "Discover the collection",
        "button_2_label": "The gift guide"
      },
      "hero.chip-1": {
        "text": "Two-year guarantee"
      },
      "hero.chip-2": {
        "text": "Hand-stitched"
      },
      "hero.chip-3": {
        "text": "Repairs for life"
      },
      "essentials": {
        "eyebrow": "The essentials",
        "heading": "Pieces for every day",
        "text": "Six classics, made in the same leather and the same colours."
      },
      "craft": {
        "eyebrow": "The workshop",
        "heading": "How a bag is made"
      },
      "craft.step-1": {
        "title": "Choose the hide",
        "text": "Full-grain leather from a tannery we have worked with for years, vegetable-tanned for a rich patina."
      },
      "craft.step-2": {
        "title": "Cut by hand",
        "text": "Each panel is cut around the best part of the hide, never stamped out."
      },
      "craft.step-3": {
        "title": "Stitch and edge",
        "text": "Saddle-stitched with waxed thread, edges burnished until they glow."
      },
      "craft.step-4": {
        "title": "Check and send",
        "text": "Every piece is inspected by the person who made it, then signed and packed."
      },
      "gifts": {
        "eyebrow": "Gift guide",
        "heading": "Find the right gift",
        "text": "Choose a budget and we will show you what fits."
      },
      "gifts.budget-1": {
        "label": "Under 100",
        "text": "Wallets, belts and small leather goods."
      },
      "gifts.budget-2": {
        "label": "100 to 200",
        "text": "Sneakers, loafers and everyday bags."
      },
      "gifts.budget-3": {
        "label": "Over 200",
        "text": "The pieces that last a lifetime."
      },
      "repair": {
        "eyebrow": "For life",
        "heading": "Repair, resole, restore",
        "text": "<p>Send a piece back after ten years and we will clean it, stitch it and polish it for the cost of the postage. Good leather deserves a long life.</p>",
        "button_label": "Our repair promise"
      },
      "reviews": {
        "heading": "Carried and trusted"
      },
      "reviews.testimonial-1": {
        "quote": "The tote has the most beautiful colour and the stitching is flawless. It is already softening nicely.",
        "detail": "Camel leather tote"
      },
      "reviews.testimonial-2": {
        "quote": "Comfortable from the first day. The loafers fit true to size and look better each week.",
        "detail": "Leather loafers"
      },
      "reviews.testimonial-3": {
        "quote": "A lovely belt, solid brass buckle, and it arrived in a beautiful box. A perfect gift.",
        "detail": "Leather belt"
      },
      "newsletter": {
        "heading": "The Maroquin letter",
        "text": "New pieces, workshop notes and care advice, once a month.",
        "button_label": "Subscribe"
      }
    },
    "fr": {
      "hero": {
        "eyebrow": "Maroquinerie",
        "heading": "Un cuir qui s’embellit avec le temps",
        "text": "Sacs, chaussures et petite maroquinerie en camel, noir et crème. Des peaux pleine fleur, cousues main et faites pour être réparées, pas remplacées.",
        "button_label": "Découvrir la collection",
        "button_2_label": "Le guide cadeaux"
      },
      "hero.chip-1": {
        "text": "Garantie deux ans"
      },
      "hero.chip-2": {
        "text": "Cousu main"
      },
      "hero.chip-3": {
        "text": "Réparations à vie"
      },
      "essentials": {
        "eyebrow": "Les essentiels",
        "heading": "Des pièces pour chaque jour",
        "text": "Six classiques, dans le même cuir et les mêmes couleurs."
      },
      "craft": {
        "eyebrow": "L’atelier",
        "heading": "Comment naît un sac"
      },
      "craft.step-1": {
        "title": "Choisir la peau",
        "text": "Cuir pleine fleur d’une tannerie avec laquelle nous travaillons depuis des années, tanné au végétal pour une patine riche."
      },
      "craft.step-2": {
        "title": "Découper à la main",
        "text": "Chaque pièce est découpée autour de la meilleure partie de la peau, jamais emboutie."
      },
      "craft.step-3": {
        "title": "Coudre et border",
        "text": "Piqûre sellier au fil ciré, tranches lissées jusqu’à ce qu’elles brillent."
      },
      "craft.step-4": {
        "title": "Contrôler et expédier",
        "text": "Chaque pièce est contrôlée par celle ou celui qui l’a faite, puis signée et emballée."
      },
      "gifts": {
        "eyebrow": "Guide cadeaux",
        "heading": "Trouvez le bon cadeau",
        "text": "Choisissez un budget et nous vous montrons ce qui convient."
      },
      "gifts.budget-1": {
        "label": "Moins de 100",
        "text": "Portefeuilles, ceintures et petite maroquinerie."
      },
      "gifts.budget-2": {
        "label": "De 100 à 200",
        "text": "Baskets, mocassins et sacs de tous les jours."
      },
      "gifts.budget-3": {
        "label": "Plus de 200",
        "text": "Les pièces qui durent toute une vie."
      },
      "repair": {
        "eyebrow": "Pour la vie",
        "heading": "Réparer, ressemeler, restaurer",
        "text": "<p>Renvoyez une pièce après dix ans et nous la nettoierons, la recoudrons et la lustrerons pour le prix de l’envoi. Un bon cuir mérite une longue vie.</p>",
        "button_label": "Notre promesse de réparation"
      },
      "reviews": {
        "heading": "Portés et approuvés"
      },
      "reviews.testimonial-1": {
        "quote": "Le cabas a une couleur sublime et les coutures sont impeccables. Il s’assouplit déjà joliment.",
        "detail": "Sac cabas en cuir camel"
      },
      "reviews.testimonial-2": {
        "quote": "Confortables dès le premier jour. Les mocassins taillent juste et sont plus beaux chaque semaine.",
        "detail": "Mocassins en cuir"
      },
      "reviews.testimonial-3": {
        "quote": "Une très belle ceinture, boucle en laiton massif, arrivée dans un joli coffret. Un cadeau parfait.",
        "detail": "Ceinture en cuir"
      },
      "newsletter": {
        "heading": "La lettre Maroquin",
