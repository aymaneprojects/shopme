        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.hero",
      "category": "banner",
      "blocks": [
        {
          "type": "chip",
          "settings": {
            "icon": "leaf"
          }
        },
        {
