      "id": "image",
      "label": "t:sections.hero.settings.image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.hero.settings.product",
      "info": "t:sections.hero.info.product"
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.appearance"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.hero.settings.layout",
      "default": "split",
      "variant": "segmented",
      "options": [
        {
          "value": "split",
