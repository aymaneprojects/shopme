{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow
  if eyebrow == blank
    assign eyebrow = 'home.hero_eyebrow' | t
  endif
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.hero_heading' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'home.hero_text' | t
  endif
  assign button_label = s.button_label
  if button_label == blank
    assign button_label = 'home.hero_button' | t
  endif
  assign button_2_label = s.button_2_label
  if button_2_label == blank
    assign button_2_label = 'home.hero_button_2' | t
  endif
  assign spot = s.product
  assign focal = ''
  if s.image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: s.image.presentation.focal_point
  elsif spot.featured_image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: spot.featured_image.presentation.focal_point
  endif
-%}
<div class="k-hero k-hero--{{ s.layout }} {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width k-hero__inner">
    <div class="k-hero__copy">
      <p class="k-eyebrow">{{ eyebrow | escape }}</p>
      <h1 class="k-hero__heading">{{ heading | escape }}</h1>
      <p class="k-hero__text">{{ text | escape }}</p>
      <div class="k-hero__actions">
        <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ button_label | escape }}</a>
        <a class="button button--outline" href="{{ s.button_2_link | default: routes.collections_url }}">{{ button_2_label | escape }}</a>
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="k-chips" role="list">
          {%- for block in section.blocks -%}
            {%- assign chip_text = block.settings.text -%}
            {%- if chip_text == blank -%}{%- assign chip_text = 'home.chip_' | append: forloop.index | t -%}{%- endif -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon, size: 16 %} {{ chip_text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="k-hero__visual">
      <div class="k-arch">
        {%- if s.image != blank -%}
          {% render 'media', media_type: 'image', image: s.image, eager: true, sizes: '(min-width: 990px) 40vw, 90vw' %}
        {%- elsif spot != blank and spot.featured_image != blank -%}
          {{ spot.featured_image | image_url: width: 900 | image_tag: loading: 'eager', alt: spot.title, style: focal }}
        {%- else -%}
          <span class="k-arch__art" aria-hidden="true"></span>
        {%- endif -%}
      </div>
      {%- if spot != blank -%}
        <a class="k-hero__product" href="{{ spot.url }}">
          <span class="k-hero__product-title">{{ spot.title | escape }}</span>
          {% render 'price', product: spot %}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero.headers.content"
    },
