            },
            {
              "value": "heart",
              "label": "t:sections.hero.blocks.chip.options.icon.heart"
            },
            {
              "value": "sun",
              "label": "t:sections.hero.blocks.chip.options.icon.sun"
            },
            {
              "value": "moon",
              "label": "t:sections.hero.blocks.chip.options.icon.moon"
            },
            {
              "value": "truck",
              "label": "t:sections.hero.blocks.chip.options.icon.truck"
            },
            {
              "value": "refresh",
              "label": "t:sections.hero.blocks.chip.options.icon.refresh"
            },
            {
              "value": "shield",
              "label": "t:sections.hero.blocks.chip.options.icon.shield"
            },
            {
              "value": "package",
              "label": "t:sections.hero.blocks.chip.options.icon.package"
            },
            {
              "value": "gift",
              "label": "t:sections.hero.blocks.chip.options.icon.gift"
            },
            {
              "value": "clock",
              "label": "t:sections.hero.blocks.chip.options.icon.clock"
            },
            {
              "value": "tag",
              "label": "t:sections.hero.blocks.chip.options.icon.tag"
            },
            {
              "value": "home",
              "label": "t:sections.hero.blocks.chip.options.icon.home"
            },
            {
              "value": "scissors",
              "label": "t:sections.hero.blocks.chip.options.icon.scissors"
            },
            {
              "value": "ruler",
              "label": "t:sections.hero.blocks.chip.options.icon.ruler"
            },
            {
