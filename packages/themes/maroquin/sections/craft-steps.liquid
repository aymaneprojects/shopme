{%- assign s = section.settings -%}
{%- assign pic = s.image | default: s.product.featured_image -%}
<div class="k-section k-craft k-craft--{{ s.layout }} {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width k-craft__inner">
    <div class="k-craft__media">
      {%- if pic != blank -%}
        {{ pic | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 720, 1000', sizes: '(min-width: 990px) 40vw, 90vw', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'k-craft__placeholder' }}
      {%- endif -%}
    </div>
    <div class="k-craft__copy">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
      <ol class="k-craft__steps" role="list">
        {%- for block in section.blocks -%}
          <li class="k-step" {{ block.shopify_attributes }}>
            <span class="k-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
            <div><h3 class="k-step__title">{{ block.settings.title | escape }}</h3><p class="k-step__text">{{ block.settings.text | escape }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.craft_steps.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.craft_steps.settings.eyebrow",
      "default": "The workshop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.craft_steps.settings.heading",
      "default": "How it is made"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.craft_steps.settings.image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.craft_steps.settings.product"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.craft_steps.settings.layout",
      "options": [
        {
          "value": "left",
          "label": "t:sections.craft_steps.options.layout.left"
        },
        {
          "value": "right",
          "label": "t:sections.craft_steps.options.layout.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.craft_steps.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.craft_steps.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.craft_steps.blocks.step.settings.title",
          "default": "Choose the hide"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.craft_steps.blocks.step.settings.text",
          "default": "Full-grain leather from a tannery we have worked with for years."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.craft_steps.presets.craft_steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
