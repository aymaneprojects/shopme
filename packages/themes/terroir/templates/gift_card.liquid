{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="ltr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t: shop: shop.name }}</title>
    {%- render 'css-variables' -%}
    {{ 'terroir.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-gift-card">
    <main id="main" class="page-width page-width--narrow section-pad gift-card">
      <h1 class="page-title">{{ 'gift_card.title' | t: shop: shop.name }}</h1>
      {%- if gift_card.enabled == false -%}
        <p class="form-errors" role="status">{{ 'gift_card.disabled' | t }}</p>
      {%- elsif gift_card.expired -%}
        <p class="form-errors" role="status">{{ 'gift_card.expired' | t: date: gift_card.expires_on }}</p>
      {%- endif -%}
      <p class="gift-card__balance"><span class="visually-hidden">{{ 'gift_card.balance' | t }}</span> <strong>{{ gift_card.balance | money }}</strong></p>
      {%- if gift_card.balance != gift_card.initial_value -%}
        {%- assign initial = gift_card.initial_value | money -%}
        <p class="gift-card__initial">{{ 'gift_card.initial_value' | t: amount: initial }}</p>
      {%- endif -%}
      {%- if gift_card.message != blank -%}
        <blockquote class="gift-card__message">{{ gift_card.message | escape }}</blockquote>
      {%- endif -%}
      <p>{{ 'gift_card.code' | t }}</p>
      <p class="gift-card__code"><code id="gift-card-code">{{ gift_card.code }}</code></p>
      {%- if gift_card.expires_on -%}
        <p class="gift-card__expires">{{ 'gift_card.expires_on' | t: date: gift_card.expires_on }}</p>
      {%- endif -%}
      <p><a class="button" href="{{ routes.root_url }}">{{ 'gift_card.shop_now' | t }}</a></p>
      <p class="gift-card__help">{{ 'gift_card.how_to' | t }}</p>
    </main>
  </body>
</html>
