<div class="section-pad newsletter-section newsletter-section--{{ section.settings.align }} {% render 'scheme-class', scheme: section.settings.color_scheme %}{% if section.settings.texture != blank and section.settings.texture != 'none' %} texture texture--{{ section.settings.texture }}{% endif %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: section.id, class: 'newsletter' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="{{ section.id }}-email">{{ 'newsletter.label' | t }}</label>
        <div class="newsletter__row">
          <input id="{{ section.id }}-email" class="input" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
          <button class="button" type="submit">{%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'newsletter.submit' | t }}{%- endif -%}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.newsletter.settings.eyebrow",
      "default": "The weekly crumb"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading",
      "default": "Recipes and new arrivals, in your inbox"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text",
      "default": "<p>One friendly email a week: what is fresh, what is in season and one recipe to try.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label",
      "info": "t:sections.newsletter.info.button_label"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.newsletter.settings.align",
      "options": [
        {
          "value": "left",
          "label": "t:shared.left"
        },
        {
          "value": "center",
          "label": "t:shared.center"
        }
      ],
      "default": "center",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.newsletter.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.newsletter.options.texture.none"
        },
        {
          "value": "paper",
          "label": "t:sections.newsletter.options.texture.paper"
        },
        {
          "value": "linen",
          "label": "t:sections.newsletter.options.texture.linen"
        },
        {
          "value": "dots",
          "label": "t:sections.newsletter.options.texture.dots"
        },
        {
          "value": "wash",
          "label": "t:sections.newsletter.options.texture.wash"
        },
        {
          "value": "grain",
          "label": "t:sections.newsletter.options.texture.grain"
        }
      ],
      "default": "paper"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.newsletter",
      "category": "form"
    }
  ]
}
{% endschema %}
