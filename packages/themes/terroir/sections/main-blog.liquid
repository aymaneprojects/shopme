<div class="section-pad blog {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  <div class="page-width">
    <header class="page-head page-head--split">
      <div>
        <p class="eyebrow">{{ 'blog.eyebrow' | t }}</p>
        <h1 class="page-title">{{ blog.title | escape }}</h1>
      </div>
      <a class="link-arrow" href="{{ blog.url }}.atom">{{ 'blog.feed' | t }}</a>
    </header>

    {%- if blog.all_tags.size > 0 -%}
      <nav class="blog__tags" aria-label="{{ 'blog.tags' | t }}">
        <a class="chip{% if current_tags.size == 0 %} is-active{% endif %}" href="{{ blog.url }}"{% if current_tags.size == 0 %} aria-current="page"{% endif %}>{{ 'blog.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a class="chip{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles_count == 0 -%}
        <p class="empty">{{ 'blog.no_articles' | t }}</p>
      {%- else -%}
        <ul class="post-list post-list--grid" role="list">
          {%- for article in blog.articles -%}
            <li>{% render 'article-card', article: article, show_image: section.settings.show_image, show_date: true, show_author: section.settings.show_author, show_excerpt: true %}</li>
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:sections.main_blog.settings.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:sections.main_blog.settings.show_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.main_blog.settings.show_author",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ]
}
{% endschema %}
