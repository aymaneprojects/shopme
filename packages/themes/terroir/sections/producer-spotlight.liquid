{%- assign s = section.settings -%}
<div class="section-pad producers {% render 'scheme-class', scheme: s.color_scheme %}{% if s.texture != blank and s.texture != 'none' %} texture texture--{{ s.texture }}{% endif %}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="section-lead">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <ul class="producers__list producers__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="producer" {{ block.shopify_attributes }}>
          <div class="producer__photo">
            {%- if block.settings.image -%}
              {%- assign focal = '' -%}
              {%- if block.settings.image.presentation.focal_point != blank -%}{%- assign focal = 'object-position: ' | append: block.settings.image.presentation.focal_point -%}{%- endif -%}
              {{ block.settings.image | image_url: width: 520, height: 520, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.name, style: focal }}
            {%- else -%}
              <span class="producer__initial" aria-hidden="true">{{ block.settings.name | slice: 0, 1 }}</span>
            {%- endif -%}
          </div>
          <h3 class="producer__name">{{ block.settings.name | escape }}</h3>
          <p class="producer__place">{{ block.settings.place | escape }}</p>
          {%- if block.settings.quote != blank -%}<blockquote class="producer__quote">{{ block.settings.quote | escape }}</blockquote>{%- endif -%}
          {%- if block.settings.link != blank -%}<a class="link-arrow" href="{{ block.settings.link }}">{{ 'blocks_terroir.producer.visit' | t }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.producer_spotlight.name",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.producer_spotlight.settings.eyebrow",
      "default": "Behind the label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.producer_spotlight.settings.heading",
      "default": "Meet the people who make it"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.producer_spotlight.settings.text",
      "default": ""
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.producer_spotlight.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.producer_spotlight.options.texture.none"
        },
        {
          "value": "paper",
          "label": "t:sections.producer_spotlight.options.texture.paper"
        },
        {
          "value": "linen",
          "label": "t:sections.producer_spotlight.options.texture.linen"
        },
        {
          "value": "dots",
          "label": "t:sections.producer_spotlight.options.texture.dots"
        },
        {
          "value": "wash",
          "label": "t:sections.producer_spotlight.options.texture.wash"
        },
        {
          "value": "grain",
          "label": "t:sections.producer_spotlight.options.texture.grain"
        }
      ],
      "default": "dots"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "producer",
      "name": "t:sections.producer_spotlight.blocks.producer.name",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.producer_spotlight.blocks.producer.settings.name",
          "default": "The Rojas family"
        },
        {
          "type": "text",
          "id": "place",
          "label": "t:sections.producer_spotlight.blocks.producer.settings.place",
          "default": "Huila, Colombia"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.producer_spotlight.blocks.producer.settings.image"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.producer_spotlight.blocks.producer.settings.quote",
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.producer_spotlight.blocks.producer.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.producer_spotlight.presets.producers",
      "category": "text",
      "blocks": [
        {
          "type": "producer",
          "settings": {
            "name": "The Rojas family",
            "place": "Huila, Colombia",
            "quote": "We pick only what is ripe, and we are in no hurry."
          }
        },
        {
          "type": "producer",
          "settings": {
            "name": "Mei and Lan",
            "place": "Fujian, China",
            "quote": "Jasmine blossoms are scented by hand, one night at a time."
          }
        },
        {
          "type": "producer",
          "settings": {
            "name": "Atelier Moulin",
            "place": "Dordogne, France",
            "quote": "Our honey comes from hives you can see from the kitchen."
          }
        }
      ]
    }
  ]
}
{% endschema %}
