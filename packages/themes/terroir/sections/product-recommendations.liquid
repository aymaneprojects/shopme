{%- assign s = section.settings -%}
<div class="section-pad recs {% render 'scheme-class', scheme: s.color_scheme %}" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.products_to_show }}&intent=related"{% unless recommendations.performed and recommendations.products_count > 0 %} hidden{% endunless %}>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-head">
        <div>
          {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="section-title">{{ s.heading | escape }}</h2>
        </div>
      </div>
      <ul class="grid grid--cols-{{ s.products_to_show | at_most: 4 }} grid--mobile-2" data-recommendations-list role="list">
        {%- for item in recommendations.products limit: s.products_to_show -%}
          <li>{% render 'product-card', card_product: item, index: forloop.index %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.product_recommendations.settings.eyebrow",
      "default": "Goes well with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.product_recommendations.settings.heading",
      "default": "You might also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.product_recommendations.settings.products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
