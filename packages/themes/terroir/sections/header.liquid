{%- liquid
  assign menu = section.settings.menu
  assign logo = settings.logo
  assign show_account = false
  if shop.customer_accounts_enabled
    if customer or routes.account_login_url != blank
      assign show_account = true
    endif
  endif
-%}
<header class="site-header drawer-side-{{ settings.drawer_side | default: 'right' }}{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
  {%- if section.settings.show_utility -%}
    <div class="utility-bar">
      <div class="page-width utility-bar__inner">
        <p class="utility-bar__text">{{ section.settings.utility_text | escape }}</p>
        <div class="utility-bar__selectors">
          {%- render 'language-selector', uid: 'h' -%}
          {%- render 'country-selector', uid: 'h' -%}
        </div>
      </div>
    </div>
  {%- endif -%}
  <div class="page-width site-header__inner">
    <button type="button" class="icon-button site-header__menu-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="visually-hidden">{{ 'accessibility.open_menu' | t }}</span>
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="site-header__brand" href="{{ routes.root_url }}">
      {%- if logo -%}
        {{ logo | image_url: width: 480 | image_tag: alt: shop.name, class: 'site-header__logo', loading: 'eager' }}
      {%- else -%}
        <span class="site-header__mark" aria-hidden="true">{% render 'icon', name: 'leaf' %}</span>
        <span class="site-header__name">{{ shop.name | escape }}</span>
      {%- endif -%}
    </a>

    <nav class="site-nav" id="site-nav" aria-label="{{ menu.title | default: shop.name | escape }}" data-nav>
      <button type="button" class="icon-button site-nav__close" data-nav-close>
        <span class="visually-hidden">{{ 'accessibility.close_menu' | t }}</span>
        {% render 'icon', name: 'close' %}
      </button>
      {%- if menu != blank and menu.links.size > 0 -%}
        <ul class="site-nav__list">
          {%- for link in menu.links -%}
            <li class="site-nav__item{% if link.links.size > 0 %} site-nav__item--parent{% endif %}" data-nav-item>
              <a class="site-nav__link{% if link.active %} is-active{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
              {%- if link.links.size > 0 -%}
                <button type="button" class="site-nav__sub-toggle" data-sub-toggle aria-expanded="false"><span class="visually-hidden">{{ link.title | escape }}</span>{% render 'icon', name: 'chevron-down' %}</button>
                <div class="mega">
                  <ul class="mega__inner page-width">
                    {%- for child in link.links -%}
                      <li class="mega__col">
                        <a class="mega__title" href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                        {%- if child.links.size > 0 -%}
                          <ul class="mega__links">
                            {%- for grand in child.links -%}<li><a href="{{ grand.url }}">{{ grand.title | escape }}</a></li>{%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                    {%- if section.settings.mega_text != blank -%}
                      <li class="mega__note"><span class="mega__note-icon">{% render 'icon', name: 'leaf' %}</span><p>{{ section.settings.mega_text | escape }}</p></li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </nav>

    <div class="site-header__actions">
      <a class="search-pill" href="{{ routes.search_url }}" data-search-toggle aria-controls="predictive-search" aria-expanded="false">
        {% render 'icon', name: 'search' %}<span>{{ 'header.search_hint' | t }}</span>
      </a>
      <a class="icon-button search-icon" href="{{ routes.search_url }}" data-search-toggle aria-controls="predictive-search" aria-expanded="false">
        <span class="visually-hidden">{{ 'header.search' | t }}</span>
        {% render 'icon', name: 'search' %}
      </a>
      {%- if show_account -%}
        <a class="icon-button site-header__account" href="{{ routes.account_url }}">
          <span class="visually-hidden">{{ 'header.account' | t }}</span>
          {% render 'icon', name: 'user' %}
        </a>
      {%- endif -%}
      <a class="icon-button cart-link" href="{{ routes.cart_url }}" data-cart-open>
        <span class="visually-hidden" data-cart-label>{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
        {% render 'icon', name: 'cart' %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
  <div class="drawer-overlay" data-nav-overlay></div>

  <div class="predictive-search" id="predictive-search" data-predictive-search data-url="{{ routes.predictive_search_url }}" data-limit="{{ settings.search_suggestions_limit | default: 4 }}" data-show-image="{{ settings.search_show_image | default: true }}" data-show-price="{{ settings.search_show_price | default: true }}" hidden>
    <div class="page-width">
      <form class="predictive-search__form" role="search" action="{{ routes.search_url }}" method="get">
        <label class="visually-hidden" for="predictive-search-q">{{ 'accessibility.search' | t }}</label>
        <input id="predictive-search-q" class="input input--lg" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="predictive-search-results" data-predictive-input>
        <button class="button" type="submit">{{ 'search.submit' | t }}</button>
        <button type="button" class="icon-button" data-search-close><span class="visually-hidden">{{ 'general.close' | t }}</span>{% render 'icon', name: 'close' %}</button>
      </form>
      {%- capture search_labels -%}
        {"queries":{{ 'search.predictive.queries' | t | json }},"products":{{ 'search.predictive.products' | t | json }},"collections":{{ 'search.predictive.collections' | t | json }},"pages":{{ 'search.predictive.pages' | t | json }},"articles":{{ 'search.predictive.articles' | t | json }},"none":{{ 'search.predictive.none' | t | json }},"all":{{ 'search.predictive.all' | t | json }}}
      {%- endcapture -%}
      <div class="predictive-search__results" id="predictive-search-results" role="listbox" aria-live="polite" data-predictive-results data-labels="{{ search_labels | escape }}"></div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "div",
  "class": "header-section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "t:sections.header.settings.sticky",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.top_strip"
    },
    {
      "type": "checkbox",
      "id": "show_utility",
      "label": "t:sections.header.settings.show_utility",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_text",
      "label": "t:sections.header.settings.utility_text",
      "default": "Small producers, big flavour"
    },
    {
      "type": "header",
      "content": "t:sections.header.headers.mega_menu"
    },
    {
      "type": "text",
      "id": "mega_text",
      "label": "t:sections.header.settings.mega_text",
      "default": "Everything is roasted and packed within the week."
    }
  ]
}
{% endschema %}
