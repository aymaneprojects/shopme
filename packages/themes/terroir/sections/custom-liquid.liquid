<div class="custom-liquid page-width {% render 'scheme-class', scheme: section.settings.color_scheme %}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {{ section.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "tag": "section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.settings.custom_liquid",
      "default": "<p></p>"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.custom_liquid.settings.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.custom_liquid.settings.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_liquid.presets.custom_liquid",
      "category": "text"
    }
  ]
}
{% endschema %}
