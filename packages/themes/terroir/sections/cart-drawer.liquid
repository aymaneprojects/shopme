{%- liquid
  assign s = section.settings
  assign threshold_cents = s.free_shipping_threshold | times: 100
  assign remaining = threshold_cents | minus: cart.total_price
-%}
<div class="cart-drawer drawer-side-{{ settings.drawer_side | default: 'right' }}" data-cart-drawer role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-overlay></div>
  <div class="cart-drawer__panel {% render 'scheme-class', scheme: s.color_scheme %}">
    <div class="cart-drawer__head">
      <h2 id="cart-drawer-title" class="cart-drawer__title">{{ 'cart.title' | t }}{% if cart.item_count > 0 %} <span class="cart-drawer__count">({{ cart.item_count }})</span>{% endif %}</h2>
      <button type="button" class="icon-button" data-cart-drawer-close><span class="visually-hidden">{{ 'general.close' | t }}</span>{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="cart-drawer__content" data-cart-drawer-content data-cart-scope>
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p class="empty">{{ 'cart.empty' | t }}</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        {%- if s.free_shipping_threshold > 0 -%}
          <div class="shipping-bar">
            {%- if remaining > 0 -%}
              {%- assign left = remaining | money -%}
              <p class="shipping-bar__text">{{ 'cart.free_shipping_left' | t: amount: left }}</p>
            {%- else -%}
              <p class="shipping-bar__text">{{ 'cart.free_shipping_reached' | t }}</p>
            {%- endif -%}
            {%- assign pct = cart.total_price | times: 100 | divided_by: threshold_cents -%}
            {%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
            <div class="shipping-bar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="{{ 'cart.free_shipping_progress' | t }}"><span style="width: {{ pct }}%"></span></div>
          </div>
        {%- endif -%}
        <ul class="cart-drawer__items" role="list">
          {%- for item in cart.items -%}
            {% render 'cart-item', item: item, index: forloop.index, variant: 'drawer' %}
          {%- endfor -%}
        </ul>
        <div class="cart-drawer__foot">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart__discounts" role="list">
              {%- for application in cart.cart_level_discount_applications -%}
                <li><span>{{ 'cart.discount' | t }}: {{ application.title | escape }}</span> <span>-{{ application.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="cart__hint">{{ 'cart.taxes_shipping' | t }}</p>
          <a class="button button--block" href="/checkout">{{ 'cart.checkout' | t }}</a>
          <a class="link-arrow cart__continue" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "free_shipping_threshold",
      "label": "t:sections.cart_drawer.settings.free_shipping_threshold",
      "info": "t:sections.cart_drawer.info.free_shipping_threshold",
      "min": 0,
      "max": 500,
      "step": 5,
      "default": 0
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ]
}
{% endschema %}
