{%- doc -%}
  Product card used in grids: rounded photo with tag badges and a quick-add button, then title, vendor and price.
  @param {product} card_product - the product to show
  @param {number} [index] - position in the list
{%- enddoc -%}
{%- liquid
  assign image = card_product.featured_image
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: image.presentation.focal_point
  endif
  assign variant = card_product.selected_or_first_available_variant
-%}
<article class="fcard pcard--align-{{ settings.card_text_align | default: 'left' }}{% unless card_product.available %} is-sold-out{% endunless %}">
  <div class="fcard__media">
    <a class="fcard__link" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
      {%- if image -%}
        {{ image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '300, 450, 600, 720', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_product.title, class: 'fcard__img', style: focal }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'pcard__placeholder' }}
      {%- endif -%}
    </a>
    <div class="fcard__badges">{% render 'product-badges', product: card_product, limit: 3 %}</div>
    {%- if settings.card_quick_add and card_product.available and card_product.has_only_default_variant -%}
      <form class="fcard__add" method="post" action="/cart/add" data-quick-add>
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="fcard__add-button"><span class="visually-hidden">{{ 'products.add_to_cart' | t }}: {{ card_product.title | escape }}</span>{% render 'icon', name: 'plus' %}</button>
      </form>
    {%- elsif settings.card_quick_add and card_product.available -%}
      <a class="fcard__add fcard__add--options" href="{{ card_product.url }}"><span class="visually-hidden">{{ 'products.choose_options' | t }}: {{ card_product.title | escape }}</span>{% render 'icon', name: 'arrow-right' %}</a>
    {%- endif -%}
  </div>
  <div class="fcard__body">
    {%- if settings.show_vendor and card_product.vendor != blank -%}<p class="fcard__vendor">{{ card_product.vendor | escape }}</p>{%- endif -%}
    <h3 class="fcard__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    {% render 'price', product: card_product %}
  </div>
</article>
