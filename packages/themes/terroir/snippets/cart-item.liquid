{%- doc -%}
  One line of the cart (page and drawer): image, title, options, subscription plan, discounts, quantity and line total.
  @param {object} item - the line item
  @param {number} index - its 1-based position (used by the cart API)
  @param {string} [variant] - drawer | page
{%- enddoc -%}
<li class="cart-item" data-line="{{ index }}">
  {%- if settings.cart_show_thumbnails != false -%}
    <a class="cart-item__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '', widths: '120, 240', sizes: '96px' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cart-item__placeholder' }}
      {%- endif -%}
    </a>
  {%- endif -%}
  <div class="cart-item__info">
    {%- if settings.cart_show_vendor and item.vendor != blank -%}<p class="cart-item__meta">{{ item.vendor | escape }}</p>{%- endif -%}
    <a class="cart-item__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      {%- for option in item.options_with_values -%}
        <p class="cart-item__meta">{{ option.name | escape }}: {{ option.value | escape }}</p>
      {%- endfor -%}
    {%- endunless -%}
    {%- if item.selling_plan_allocation -%}
      {%- assign per_delivery = item.selling_plan_allocation.per_delivery_price | money -%}
      <p class="cart-item__plan">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
      <p class="cart-item__meta">{{ 'cart.recurring' | t: price: per_delivery }}</p>
    {%- endif -%}
    {%- for allocation in item.line_level_discount_allocations -%}
      <p class="cart-item__discount">{{ 'cart.discount' | t }}: {{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</p>
    {%- endfor -%}
    <p class="cart-item__unit">
      {%- if item.original_price != item.final_price -%}<s class="cart-item__was">{{ item.original_price | money }}</s> {% endif -%}
      {{ item.final_price | money }}
    </p>
    <div class="cart-item__controls">
      <div class="quantity quantity--compact">
        <button type="button" class="quantity__button" data-qty-step="-1" data-line="{{ index }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus' %}</button>
        <input class="quantity__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-line-qty data-line="{{ index }}" aria-label="{{ 'accessibility.quantity' | t }}: {{ item.product.title | escape }}">
        <button type="button" class="quantity__button" data-qty-step="1" data-line="{{ index }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus' %}</button>
      </div>
      <a class="cart-item__remove" href="{{ item.url_to_remove }}" data-remove-line="{{ index }}">{{ 'cart.remove' | t }}<span class="visually-hidden"> {{ item.product.title | escape }}</span></a>
    </div>
  </div>
  <p class="cart-item__total">{{ item.final_line_price | money }}</p>
</li>
