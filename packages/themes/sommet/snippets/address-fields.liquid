{%- doc -%}
  Address form fields (names follow the address[...] convention).
  @param {object} address - the address being edited (blank for a new one)
  @param {string} uid - unique suffix for field ids
{%- enddoc -%}
<div class="field-row">
  <div class="field"><label for="AddressFirstName-{{ uid }}">{{ 'customer.first_name' | t }}</label><input id="AddressFirstName-{{ uid }}" type="text" name="address[first_name]" value="{{ address.first_name | escape }}" autocomplete="given-name"></div>
  <div class="field"><label for="AddressLastName-{{ uid }}">{{ 'customer.last_name' | t }}</label><input id="AddressLastName-{{ uid }}" type="text" name="address[last_name]" value="{{ address.last_name | escape }}" autocomplete="family-name"></div>
</div>
<div class="field"><label for="AddressCompany-{{ uid }}">{{ 'customer.addresses.company' | t }}</label><input id="AddressCompany-{{ uid }}" type="text" name="address[company]" value="{{ address.company | escape }}" autocomplete="organization"></div>
<div class="field"><label for="Address1-{{ uid }}">{{ 'customer.addresses.address1' | t }}</label><input id="Address1-{{ uid }}" type="text" name="address[address1]" value="{{ address.address1 | escape }}" autocomplete="address-line1" required></div>
<div class="field"><label for="Address2-{{ uid }}">{{ 'customer.addresses.address2' | t }}</label><input id="Address2-{{ uid }}" type="text" name="address[address2]" value="{{ address.address2 | escape }}" autocomplete="address-line2"></div>
<div class="field-row">
  <div class="field"><label for="AddressCity-{{ uid }}">{{ 'customer.addresses.city' | t }}</label><input id="AddressCity-{{ uid }}" type="text" name="address[city]" value="{{ address.city | escape }}" autocomplete="address-level2" required></div>
  <div class="field"><label for="AddressZip-{{ uid }}">{{ 'customer.addresses.zip' | t }}</label><input id="AddressZip-{{ uid }}" type="text" name="address[zip]" value="{{ address.zip | escape }}" autocomplete="postal-code"></div>
</div>
<div class="field-row">
  <div class="field"><label for="AddressCountry-{{ uid }}">{{ 'customer.addresses.country' | t }}</label><select id="AddressCountry-{{ uid }}" name="address[country]" data-default="{{ address.country_code | default: shop.address.country_code }}" autocomplete="country" required>{{ all_country_option_tags }}</select></div>
  <div class="field"><label for="AddressProvince-{{ uid }}">{{ 'customer.addresses.province' | t }}</label><input id="AddressProvince-{{ uid }}" type="text" name="address[province]" value="{{ address.province | escape }}" autocomplete="address-level1"></div>
</div>
<div class="field"><label for="AddressPhone-{{ uid }}">{{ 'customer.addresses.phone' | t }}</label><input id="AddressPhone-{{ uid }}" type="tel" name="address[phone]" value="{{ address.phone | escape }}" autocomplete="tel"></div>
<label class="field field--check"><input type="checkbox" name="address[default]" value="1"{% if address.id and address.id == customer.default_address.id %} checked{% endif %}><span>{{ 'customer.addresses.set_default' | t }}</span></label>
