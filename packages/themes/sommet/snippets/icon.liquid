  @param {number} [size] - width and height in pixels
{%- enddoc -%}
{%- assign sz = size | default: settings.icon_size | default: 22 -%}
<svg class="icon icon--{{ name }}" width="{{ sz }}" height="{{ sz }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'bag' -%}<path d="M5.5 8.5h13l-1 11.5h-11z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
    {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20.5c.7-3.6 3.7-5.5 7.5-5.5s6.8 1.9 7.5 5.5"/>
    {%- when 'menu' -%}<path d="M4 8h16M4 16h10"/>
    {%- when 'close' -%}<path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'plus' -%}<path d="M12 5.5v13M5.5 12h13"/>
    {%- when 'minus' -%}<path d="M5.5 12h13"/>
    {%- when 'chevron-down' -%}<path d="m6.5 9.5 5.5 5.5 5.5-5.5"/>
    {%- when 'chevron-right' -%}<path d="m9.5 6.5 5.5 5.5-5.5 5.5"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13.5 14-14 .5 9-5 14-13 14"/><path d="M5 19c3-4 6-6.5 9.5-8"/>
    {%- when 'drop' -%}<path d="M12 3.5c3.5 4 6 7 6 10a6 6 0 0 1-12 0c0-3 2.5-6 6-10z"/>
    {%- when 'sparkle' -%}<path d="M12 3.5c.8 4.5 2.5 6.2 7 7-4.5.8-6.2 2.5-7 7-.8-4.5-2.5-6.2-7-7 4.5-.8 6.2-2.5 7-7z"/><path d="M19 3.5v3M17.5 5h3"/>
    {%- when 'truck' -%}<path d="M3 7h10v9H3zM13 10h4.5l3 3v3H13"/><circle cx="7" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>
