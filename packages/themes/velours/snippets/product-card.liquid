{%- doc -%}
  Soft product card: an arched photo, centered name and price, shade swatches and a quick add button.
  @param {product} card_product - the product to show
  @param {string} [sizes] - image sizes attribute
{%- enddoc -%}
{%- liquid
  assign image = card_product.featured_image
  assign second = card_product.images[1]
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: image.presentation.focal_point
  endif
  assign sizes_attr = sizes | default: '(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw'
  assign swatch_names = settings.swatch_option_names | downcase | split: ','
  assign shade_option = nil
  if settings.card_show_swatches and settings.swatches_enabled
    for option in card_product.options_with_values
      assign option_key = option.name | downcase | strip
      if swatch_names contains option_key
        assign shade_option = option
      endif
    endfor
  endif
-%}
<article class="vl-card vl-card--align-{{ settings.card_text_align | default: 'center' }}">
  <div class="vl-card__frame">
    <a class="vl-card__media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
      {%- if image -%}
        {{ image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: sizes_attr, alt: card_product.title, style: focal, class: 'vl-card__img' }}
        {%- if second -%}{{ second | image_url: width: 640 | image_tag: loading: 'lazy', alt: '', class: 'vl-card__img vl-card__img--alt' }}{%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'vl-card__placeholder' }}
      {%- endif -%}
    </a>
    {%- unless card_product.available -%}
      {%- if settings.badge_show_sold_out != false -%}<span class="vl-badge vl-badge--out vl-badge--{{ settings.badge_position | default: 'top-left' }}">{{ 'products.sold_out' | t }}</span>{%- endif -%}
    {%- elsif card_product.compare_at_price > card_product.price and settings.badge_show_sale != false -%}
      <span class="vl-badge vl-badge--sale vl-badge--{{ settings.badge_position | default: 'top-left' }}">
        {%- if settings.badge_sale_percent -%}
          {%- assign saved = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price | floor -%}
          -{{ saved }}%
        {%- else -%}
          {{ 'products.sale' | t }}
        {%- endif -%}
      </span>
    {%- endunless -%}
    {%- if settings.card_show_quick_add and card_product.available -%}
      {%- if card_product.variants.size == 1 and card_product.requires_selling_plan != true -%}
        {%- form 'product', card_product, class: 'vl-quick' -%}
          <input type="hidden" name="id" value="{{ card_product.variants.first.id }}">
          <button type="submit" class="vl-quick__btn" name="add">{% render 'icon', name: 'plus', size: 16 %} <span>{{ 'products.add_to_cart' | t }}</span><span class="visually-hidden">: {{ card_product.title | escape }}</span></button>
        {%- endform -%}
      {%- else -%}
        <a class="vl-quick__btn vl-quick__btn--link" href="{{ card_product.url }}">{{ 'products.choose_options' | t }}<span class="visually-hidden">: {{ card_product.title | escape }}</span></a>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="vl-card__body">
    {%- if settings.show_vendor and card_product.vendor != blank -%}<p class="vl-card__brand">{{ card_product.vendor | escape }}</p>{%- endif -%}
    <h3 class="vl-card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    {% render 'price', product: card_product %}
    {%- if shade_option != nil and shade_option.values.size > 0 -%}
      <ul class="vl-shades" role="list" aria-label="{{ shade_option.name | escape }}">
        {%- for value in shade_option.values limit: 6 -%}
          <li><span class="vl-shade" style="{% render 'swatch-style', name: value %}" title="{{ value | escape }}"><span class="visually-hidden">{{ value | escape }}</span></span></li>
        {%- endfor -%}
        {%- if shade_option.values.size > 6 -%}<li class="vl-shades__more">+{{ shade_option.values.size | minus: 6 }}</li>{%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</article>
