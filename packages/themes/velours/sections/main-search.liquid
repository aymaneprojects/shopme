{%- assign s = section.settings -%}
<div class="page-width vl-listing">
  <header class="vl-listing__head">
    <h1 class="vl-listing__title">{{ 'search.title' | t }}</h1>
    <form class="vl-search-page" role="search" action="{{ routes.search_url }}" method="get">
      <label class="visually-hidden" for="search-q">{{ 'accessibility.search' | t }}</label>
      <input id="search-q" class="vl-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
      <input type="hidden" name="type" value="{{ search.types | join: ',' }}">
      <button class="button" type="submit">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed and search.results_count > 0 -%}<p class="vl-listing__count">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>{%- endif -%}
  </header>
  {%- if search.performed -%}
    {%- paginate search.results by s.products_per_page -%}
      {%- if search.results_count > 0 -%}
        {%- if search.corrected_terms -%}<p class="vl-note">{{ 'search.corrected' | t: terms: search.corrected_terms }}</p>{%- endif -%}
        {%- if search.filters.size > 0 -%}
          {%- assign search_types_joined = search.types | join: ',' -%}
          {% render 'filters', filters: search.filters, sort_options: search.sort_options, sort_by: search.sort_by, action: search.url | split: '?' | first, search_terms: search.terms, search_types: search_types_joined %}
        {%- endif -%}
        <ul class="vl-grid vl-grid--{{ s.columns }}" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'article' or item.object_type == 'page' -%}
              <li class="vl-result">
                <a class="vl-result__link" href="{{ item.url }}">
                  <span class="vl-result__type">{{ 'search.type.' | append: item.object_type | t }}</span>
                  <span class="vl-result__title">{{ item.title | escape }}</span>
                  <span class="vl-result__excerpt">{{ item.excerpt_or_content | default: item.content | strip_html | truncate: 140 }}</span>
                </a>
              </li>
            {%- else -%}
              <li>{% render 'product-card', card_product: item %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <p class="empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_search.settings.products_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.main_search.settings.columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "t:sections.main_search.options.columns.2"
        },
        {
          "value": "3",
          "label": "t:sections.main_search.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.main_search.options.columns.4"
        }
      ]
    }
  ]
}
{% endschema %}
