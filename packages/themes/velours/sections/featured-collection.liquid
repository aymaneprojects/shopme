{%- liquid
  assign s = section.settings
  assign collection = s.collection
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.featured_heading' | t
  endif
  assign intro = s.text
-%}
<div class="vl-section {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="vl-section__head vl-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="vl-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="vl-section__title">{{ heading | escape }}</h2>
      {%- if intro != blank -%}<p class="vl-section__text">{{ intro | escape }}</p>{%- endif -%}
    </div>
    {%- if collection != blank and collection.products.size > 0 -%}
      <ul class="vl-grid vl-grid--{{ s.columns }}" role="list">
        {%- for product in collection.products limit: s.products_to_show -%}
          <li>{% render 'product-card', card_product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if s.show_view_all -%}<p class="vl-section__more"><a class="button button--outline" href="{{ collection.url }}">{{ 'general.view_all' | t }}</a></p>{%- endif -%}
    {%- else -%}
      <p class="empty">{{ 'general.no_products' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.featured_collection.settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading",
      "info": "t:sections.featured_collection.info.heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.featured_collection.settings.text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection",
      "default": "all"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.featured_collection.settings.columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "t:sections.featured_collection.options.columns.2"
        },
        {
          "value": "3",
          "label": "t:sections.featured_collection.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.featured_collection.options.columns.4"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.featured_collection.settings.color_scheme",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.featured_collection",
      "category": "collection"
    }
  ]
}
{% endschema %}
