{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.story_heading' | t
  endif
  assign text = s.text
  assign button_label = s.button_label
  if button_label == blank
    assign button_label = 'home.story_button' | t
  endif
  assign focal = ''
  if s.image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: s.image.presentation.focal_point
  endif
-%}
<div class="vl-section vl-story vl-story--{{ s.layout }} {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width vl-story__inner">
    <div class="vl-story__media{% if s.image == blank %} vl-story__media--art{% endif %}">
      {%- if s.image != blank -%}{{ s.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: s.image.alt, sizes: '(min-width: 990px) 45vw, 100vw', style: focal }}{%- else -%}<span aria-hidden="true"></span>{%- endif -%}
    </div>
    <div class="vl-story__copy">
      {%- if s.eyebrow != blank -%}<p class="vl-eyebrow">{{ s.eyebrow | escape }}</p>{%- else -%}<p class="vl-eyebrow">{{ 'home.story_eyebrow' | t }}</p>{%- endif -%}
      <h2 class="vl-section__title">{{ heading | escape }}</h2>
      {%- if text != blank -%}<div class="rte">{{ text }}</div>{%- else -%}<p>{{ 'home.story_text' | t }}</p>{%- endif -%}
      <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ button_label | escape }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.image_with_text.settings.eyebrow",
      "info": "t:sections.image_with_text.info.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_with_text.settings.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image_with_text.settings.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.settings.button_link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout",
      "default": "left",
      "variant": "segmented",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.options.layout.left"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.options.layout.right"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.image_with_text.settings.color_scheme",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.image_with_text",
      "category": "image"
    }
  ]
}
{% endschema %}
