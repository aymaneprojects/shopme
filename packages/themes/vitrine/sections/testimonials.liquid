{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'testimonials.heading' | t
  endif
-%}
<div class="k-section k-quotes {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      <p class="k-eyebrow">{{ 'testimonials.eyebrow' | t }}</p>
      <h2 class="k-section__title">{{ heading | escape }}</h2>
    </div>
    <ul class="k-quotes__list k-quotes__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign key = 'testimonials.item_' | append: forloop.index
          assign quote = block.settings.quote
          assign who = block.settings.name
          assign detail = block.settings.detail
          if quote == blank
            assign quote = key | append: '_quote' | t
          endif
          if who == blank
            assign who = key | append: '_name' | t
          endif
          if detail == blank
            assign detail = key | append: '_detail' | t
          endif
          assign stars = block.settings.rating
        -%}
        <li class="k-quote" {{ block.shopify_attributes }}>
          <span class="k-quote__mark" aria-hidden="true">{% render 'icon', name: 'quote', size: 30 %}</span>
          {%- if stars > 0 -%}
            <p class="k-quote__stars" role="img" aria-label="{{ 'testimonials.rating' | t: rating: stars }}">
              {%- for i in (1..5) -%}<span class="k-star{% if i <= stars %} is-on{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}
            </p>
          {%- endif -%}
          <blockquote class="k-quote__text">{{ quote | escape }}</blockquote>
          <p class="k-quote__who">
            {%- if block.settings.avatar -%}<span class="k-quote__avatar">{{ block.settings.avatar | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}</span>{%- else -%}<span class="k-quote__avatar k-quote__avatar--initial" aria-hidden="true">{{ who | slice: 0, 1 | upcase }}</span>{%- endif -%}
            <span><strong>{{ who | escape }}</strong><br><span class="k-quote__detail">{{ detail | escape }}</span></span>
          </p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading",
      "info": "t:sections.testimonials.info.heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.testimonials.settings.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "limit": 6,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "t:sections.testimonials.blocks.testimonial.settings.detail",
          "info": "t:sections.testimonials.blocks.testimonial.info.detail"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.testimonial.settings.avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.testimonials.presets.testimonials",
      "category": "text",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
