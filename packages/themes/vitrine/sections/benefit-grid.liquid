{%- assign s = section.settings -%}
<div id="benefits" class="k-section k-benefit-grid {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="k-bgrid__lead">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <ul class="k-bgrid" role="list">
      {%- for block in section.blocks -%}
        <li class="k-bgrid__item" {{ block.shopify_attributes }}>
          <span class="k-bgrid__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <h3 class="k-bgrid__title">{{ block.settings.title | escape }}</h3>
          <p class="k-bgrid__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.benefit_grid.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.benefit_grid.settings.eyebrow",
      "default": "Why this one"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.benefit_grid.settings.heading",
      "default": "Made to be the last one you buy"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.benefit_grid.settings.text",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.benefit_grid.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.benefit_grid.blocks.benefit.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.benefit_grid.blocks.benefit.settings.icon",
          "options": [
            {
              "value": "leaf",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.leaf"
            },
            {
              "value": "drop",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.drop"
            },
            {
              "value": "sparkle",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.sparkle"
            },
            {
              "value": "heart",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.heart"
            },
            {
              "value": "truck",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.truck"
            },
            {
              "value": "check",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.check"
            },
            {
              "value": "refresh",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.refresh"
            },
            {
              "value": "shield",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.shield"
            },
            {
              "value": "package",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.package"
            },
            {
              "value": "gift",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.gift"
            },
            {
              "value": "clock",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.clock"
            },
            {
              "value": "sun",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.sun"
            },
            {
              "value": "scissors",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.scissors"
            },
            {
              "value": "home",
              "label": "t:sections.benefit_grid.blocks.benefit.options.icon.home"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.benefit_grid.blocks.benefit.settings.title",
          "default": "Keeps cold for 24 hours"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.benefit_grid.blocks.benefit.settings.text",
          "default": "Double-wall steel holds ice from morning to night."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.benefit_grid.presets.benefit_grid",
      "blocks": [
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        },
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
