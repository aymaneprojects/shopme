{%- assign s = section.settings -%}
<div class="k-section k-rooms {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
    <ul class="k-rooms__grid k-rooms__grid--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign room = block.settings -%}
        {%- assign pic = room.image | default: room.product.featured_image -%}
        <li class="k-room k-room--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <a class="k-room__link{% if room.image == blank %} k-room__link--product{% endif %}" href="{{ room.link | default: room.product.url | default: routes.collections_url }}">
            {%- if pic != blank -%}
              {{ pic | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 90vw', alt: '' }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'k-room__placeholder' }}
            {%- endif -%}
            <span class="k-room__label"><span class="k-room__title">{{ room.title | escape }}</span><span class="k-room__arrow">{% render 'icon', name: 'arrow-right', size: 16 %}</span></span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.room_tiles.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.room_tiles.settings.eyebrow",
      "default": "Room by room"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.room_tiles.settings.heading",
      "default": "Find your corner"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.room_tiles.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "t:sections.room_tiles.blocks.room.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.room_tiles.blocks.room.settings.image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.room_tiles.blocks.room.settings.product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.room_tiles.blocks.room.settings.title",
          "default": "Living room"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.room_tiles.blocks.room.settings.link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.room_tiles.presets.room_tiles",
      "blocks": [
        {
          "type": "room"
        },
        {
          "type": "room"
        },
        {
          "type": "room"
        }
      ]
    }
  ]
}
{% endschema %}
