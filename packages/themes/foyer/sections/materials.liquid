{%- assign s = section.settings -%}
<div class="k-section k-materials {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="k-section__text">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <ul class="k-materials__list k-materials__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="k-material" {{ block.shopify_attributes }}>
          <span class="k-material__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <h3 class="k-material__title">{{ block.settings.title | escape }}</h3>
          <p class="k-material__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.materials.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.materials.settings.eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.materials.settings.heading",
      "default": "Materials and care"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.materials.settings.text"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.materials.settings.color_scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "material",
      "name": "t:sections.materials.blocks.material.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.materials.blocks.material.settings.icon",
          "options": [
            {
              "value": "leaf",
              "label": "t:sections.materials.blocks.material.options.icon.leaf"
            },
            {
              "value": "drop",
              "label": "t:sections.materials.blocks.material.options.icon.drop"
            },
            {
              "value": "sun",
              "label": "t:sections.materials.blocks.material.options.icon.sun"
            },
            {
              "value": "shield",
              "label": "t:sections.materials.blocks.material.options.icon.shield"
            },
            {
              "value": "refresh",
              "label": "t:sections.materials.blocks.material.options.icon.refresh"
            },
            {
              "value": "package",
              "label": "t:sections.materials.blocks.material.options.icon.package"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.materials.blocks.material.settings.title",
          "default": "Natural fibres"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.materials.blocks.material.settings.text",
          "default": "Linen, cotton and wool, chosen for how they age."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "t:sections.materials.presets.materials",
      "blocks": [
        {
          "type": "material"
        },
        {
          "type": "material",
          "settings": {
            "icon": "drop"
          }
        },
        {
          "type": "material",
          "settings": {
            "icon": "refresh"
          }
        }
      ]
    }
  ]
}
{% endschema %}
