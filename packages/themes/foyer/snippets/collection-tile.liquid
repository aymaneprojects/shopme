{%- doc -%}
  Round-cornered tile linking to a collection, with a soft gradient when it has no image.
  @param {collection} tile_collection - the collection to show
  @param {number} [index] - position, used to vary the gradient of tiles without an image
{%- enddoc -%}
{%- liquid
  assign image = tile_collection.image | default: tile_collection.featured_image
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: image.presentation.focal_point
  endif
-%}
<a class="k-tile k-tile--{{ index | default: 1 | modulo: 4 }}" href="{{ tile_collection.url }}">
  <span class="k-tile__media">
    {%- if image -%}
      {{ image | image_url: width: 720 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw', alt: '', style: focal }}
    {%- endif -%}
  </span>
  <span class="k-tile__label">
    <span class="k-tile__title">{{ tile_collection.title | escape }}</span>
    <span class="k-tile__arrow">{% render 'icon', name: 'arrow-right', size: 18 %}</span>
  </span>
</a>
