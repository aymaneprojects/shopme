{%- doc -%}
  Prints the CSS font stack of a font choice from the theme settings.
  @param {string} font - system-sans | system-serif | system-mono | inter | manrope | space-grotesk
{%- enddoc -%}
{%- case font -%}
  {%- when 'system-serif' -%}Georgia, 'Times New Roman', serif
  {%- when 'system-mono' -%}ui-monospace, 'SF Mono', Menlo, Consolas, monospace
  {%- when 'inter' -%}'Circuit Inter', system-ui, sans-serif
  {%- when 'manrope' -%}'Circuit Manrope', system-ui, sans-serif
  {%- when 'space-grotesk' -%}'Circuit Space Grotesk', system-ui, sans-serif
  {%- else -%}system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
{%- endcase -%}
