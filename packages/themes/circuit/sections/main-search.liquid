{%- assign s = section.settings -%}
<div class="page-width cx-listing">
  <header class="cx-listing__head">
    <div>
      <h1 class="cx-listing__title">{{ 'search.title' | t }}</h1>
      <form class="cx-search-page" role="search" action="{{ routes.search_url }}" method="get">
        <label class="visually-hidden" for="search-q">{{ 'accessibility.search' | t }}</label>
        <input id="search-q" class="cx-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autocomplete="off">
        <input type="hidden" name="type" value="{{ search.types | join: ',' }}">
        <button class="button" type="submit">{{ 'search.submit' | t }}</button>
      </form>
    </div>
    {%- if search.performed -%}<p class="cx-listing__count cx-mono">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>{%- endif -%}
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by s.products_per_page -%}
      {%- if search.results_count > 0 -%}
        {%- if search.corrected_terms -%}<p class="cx-note">{{ 'search.corrected' | t: terms: search.corrected_terms }}</p>{%- endif -%}
        {%- assign search_types_joined = search.types | join: ',' -%}
        <div class="cx-listing__layout{% if search.filters.size == 0 %} cx-listing__layout--full{% endif %}">
          {%- if search.filters.size > 0 -%}
            <div class="cx-listing__side" data-filters-panel>
              {% render 'filters', filters: search.filters, sort_options: search.sort_options, sort_by: search.sort_by, action: search.url | split: '?' | first, search_terms: search.terms, search_types: search_types_joined %}
            </div>
          {%- endif -%}
          <div class="cx-listing__main">
            {%- if search.filters.size > 0 -%}
              <div class="cx-listing__bar"><button type="button" class="button button--outline button--small cx-listing__filter-btn" data-filters-open aria-controls="cx-filters">{% render 'icon', name: 'filter', size: 16 %} {{ 'collection.filter' | t }}</button></div>
            {%- endif -%}
            <ul class="cx-grid cx-grid--{{ s.columns }}" role="list" data-product-grid>
              {%- for item in search.results -%}
                {%- if item.object_type == 'article' or item.object_type == 'page' -%}
                  <li class="cx-result">
                    <a class="cx-result__link" href="{{ item.url }}">
                      <span class="cx-result__type cx-mono">{{ 'search.type.' | append: item.object_type | t }}</span>
                      <span class="cx-result__title">{{ item.title | escape }}</span>
                      <span class="cx-result__excerpt">{{ item.excerpt_or_content | default: item.content | strip_html | truncate: 140 }}</span>
                    </a>
                  </li>
                {%- else -%}
                  <li>{% render 'product-card', card_product: item %}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
            {% render 'pagination', paginate: paginate %}
          </div>
        </div>
        {%- if search.filters.size > 0 -%}<div class="cx-overlay cx-overlay--filters" data-filters-close></div>{%- endif -%}
      {%- else -%}
        <p class="empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_search.settings.products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.main_search.settings.columns",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:sections.main_search.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.main_search.options.columns.4"
        },
        {
          "value": "5",
          "label": "t:sections.main_search.options.columns.5"
        }
      ]
    }
  ]
}
{% endschema %}
