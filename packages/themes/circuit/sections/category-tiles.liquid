{%- liquid
  assign s = section.settings
  assign picked = s.collections
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.categories_heading' | t
  endif
-%}
<div class="page-width cx-section cx-cats {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="cx-section__head">
    <h2 class="cx-section__title">{{ heading | escape }}</h2>
    <a class="cx-more" href="{{ routes.collections_url }}">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow-right', size: 16 %}</a>
  </div>
  <ul class="cx-cats__list cx-cats__list--{{ s.columns }}" role="list">
    {%- if picked.size > 0 -%}
      {%- for collection in picked limit: 12 -%}
        <li>{% render 'collection-tile', tile_collection: collection, show_count: s.show_count, index: forloop.index %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for collection in collections limit: 12 -%}
        {%- if collection.handle != 'all' and collection.handle != 'frontpage' -%}
          <li>{% render 'collection-tile', tile_collection: collection, show_count: s.show_count, index: forloop.index %}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.category_tiles.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.category_tiles.settings.heading",
      "info": "t:sections.category_tiles.info.heading"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:sections.category_tiles.settings.collections",
      "info": "t:sections.category_tiles.info.collections"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.category_tiles.settings.columns",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "t:sections.category_tiles.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.category_tiles.options.columns.4"
        },
        {
          "value": "6",
          "label": "t:sections.category_tiles.options.columns.6"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "t:sections.category_tiles.settings.show_count",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.category_tiles.settings.color_scheme",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:sections.category_tiles.presets.department_tiles",
      "category": "collection"
    }
  ]
}
{% endschema %}
