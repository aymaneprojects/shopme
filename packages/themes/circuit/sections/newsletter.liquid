{%- liquid
  assign s = section.settings
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.newsletter_heading' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'home.newsletter_text' | t
  endif
  assign button_label = s.button_label
  if button_label == blank
    assign button_label = 'newsletter.submit' | t
  endif
-%}
<div class="cx-section cx-newsletter-band {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width cx-newsletter-band__inner">
    <div>
      <h2 class="cx-section__title">{{ heading | escape }}</h2>
      <p>{{ text | escape }}</p>
    </div>
    {%- form 'customer', id: section.id, class: 'cx-newsletter' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="{{ section.id }}-email">{{ 'newsletter.label' | t }}</label>
        <div class="cx-newsletter__row">
          <input id="{{ section.id }}-email" class="cx-input" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
          <button class="button" type="submit">{{ button_label | escape }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading",
      "info": "t:sections.newsletter.info.heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.newsletter.settings.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.newsletter",
      "category": "form"
    }
  ]
}
{% endschema %}
