{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow
  if eyebrow == blank
    assign eyebrow = 'home.hero_eyebrow' | t
  endif
  assign heading = s.heading
  if heading == blank
    assign heading = 'home.hero_heading' | t
  endif
  assign text = s.text
  if text == blank
    assign text = 'home.hero_text' | t
  endif
  assign button_label = s.button_label
  if button_label == blank
    assign button_label = 'home.hero_button' | t
  endif
  assign button_2_label = s.button_2_label
  if button_2_label == blank
    assign button_2_label = 'home.hero_button_2' | t
  endif
  assign spot = s.product
-%}
<div class="cx-hero {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width cx-hero__inner{% if spot == blank and s.image == blank %} cx-hero__inner--solo{% endif %}">
    <div class="cx-hero__copy">
      <p class="cx-eyebrow cx-mono"><span class="cx-dot" aria-hidden="true"></span> {{ eyebrow | escape }}</p>
      <h1 class="cx-hero__heading">{{ heading | escape }}</h1>
      <p class="cx-hero__text">{{ text | escape }}</p>
      <div class="cx-hero__actions">
        <a class="button" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ button_label | escape }}</a>
        <a class="button button--outline" href="{{ s.button_2_link | default: routes.collections_url }}">{{ button_2_label | escape }}</a>
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="cx-stats">
          {%- for block in section.blocks -%}
            {%- liquid
              assign stat_value = block.settings.value
              assign stat_label = block.settings.label
              assign stat_key = 'home.stat_' | append: forloop.index
              if stat_value == blank
                assign stat_value = stat_key | append: '_value' | t
              endif
              if stat_label == blank
                assign stat_label = stat_key | append: '_label' | t
              endif
            -%}
            <div {{ block.shopify_attributes }}><dt class="cx-mono">{{ stat_value | escape }}</dt><dd>{{ stat_label | escape }}</dd></div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
    {%- if spot != blank -%}
      {%- assign spot_focal = '' -%}
      {%- if spot.featured_image.presentation.focal_point != blank -%}{%- assign spot_focal = 'object-position: ' | append: spot.featured_image.presentation.focal_point -%}{%- endif -%}
      <a class="cx-spot" href="{{ spot.url }}">
        <span class="cx-spot__tag cx-mono">{{ 'home.spotlight' | t }}</span>
        <span class="cx-spot__media">
          {%- if spot.featured_image -%}{{ spot.featured_image | image_url: width: 800 | image_tag: loading: 'eager', alt: spot.title, style: spot_focal }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'cx-card__placeholder' }}{%- endif -%}
        </span>
        <span class="cx-spot__title">{{ spot.title | escape }}</span>
        <span class="cx-spot__price">{% render 'price', product: spot %}</span>
      </a>
    {%- elsif s.image != blank -%}
      <div class="cx-hero__media">{% render 'media', media_type: 'image', image: s.image, eager: true, sizes: '(min-width: 990px) 40vw, 100vw' %}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero.headers.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.settings.eyebrow",
      "info": "t:sections.hero.info.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.hero.settings.text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "t:sections.hero.settings.button_2_label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "t:sections.hero.settings.button_2_link"
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.media"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.hero.settings.product",
      "info": "t:sections.hero.info.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image",
      "info": "t:sections.hero.info.image"
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.hero.settings.color_scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:sections.hero.blocks.stat.name",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:sections.hero.blocks.stat.settings.value"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.hero.blocks.stat.settings.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.hero",
      "category": "banner",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}
