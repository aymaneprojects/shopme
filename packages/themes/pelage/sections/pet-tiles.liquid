{%- assign s = section.settings -%}
<div class="k-section k-pets {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
    <ul class="k-pets__list k-pets__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign pet = block.settings -%}
        {%- assign pic = pet.image | default: pet.product.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="k-pet" href="{{ pet.link | default: pet.product.url | default: routes.collections_url }}">
            <span class="k-pet__photo{% if pet.image == blank %} k-pet__photo--product{% endif %}">
              {%- if pic != blank -%}{{ pic | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 30vw, 90vw', alt: '' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'k-pet__placeholder' }}{%- endif -%}
            </span>
            <span class="k-pet__title">{{ pet.title | escape }}</span>
            <span class="k-pet__text">{{ pet.text | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.pet_tiles.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.pet_tiles.settings.eyebrow",
      "default": "Shop by pet"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.pet_tiles.settings.heading",
      "default": "Who are we shopping for?"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.pet_tiles.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "pet",
      "name": "t:sections.pet_tiles.blocks.pet.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.pet_tiles.blocks.pet.settings.image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.pet_tiles.blocks.pet.settings.product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.pet_tiles.blocks.pet.settings.title",
          "default": "For dogs"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.pet_tiles.blocks.pet.settings.text",
          "default": "Beds, bowls, leads and toys."
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.pet_tiles.blocks.pet.settings.link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.pet_tiles.presets.pet_tiles",
      "blocks": [
        {
          "type": "pet"
        },
        {
          "type": "pet"
        }
      ]
    }
  ]
}
{% endschema %}
