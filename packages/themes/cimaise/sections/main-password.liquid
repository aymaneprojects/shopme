<div class="password">
  <div class="password__card">
    <h1 class="password__title">{{ shop.name | escape }}</h1>
    <p>{% if shop.password_message != blank %}{{ shop.password_message | escape }}{% else %}{{ 'password.message' | t }}{% endif %}</p>
    {%- form 'storefront_password', class: 'password__form' -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ 'password.wrong' | t }}</div>
      {%- endif -%}
      <label class="visually-hidden" for="password-field">{{ 'password.label' | t }}</label>
      <input id="password-field" class="search-form__input" type="password" name="password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password" required>
      <button class="button" type="submit">{{ 'password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "settings": []
}
{% endschema %}
