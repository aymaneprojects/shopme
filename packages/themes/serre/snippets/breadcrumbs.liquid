{%- doc -%}
  Breadcrumb trail: Home > Collection > Product.
  @param {collection} [collection] - the collection (collection and product pages)
  @param {product} [product] - the product (product page)
{%- enddoc -%}
{%- assign crumb_collection = collection -%}
<nav class="k-crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
  <ol>
    <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
    {%- if product != blank -%}
      {%- if crumb_collection != blank and crumb_collection.url != blank -%}
        <li><a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a></li>
      {%- else -%}
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.all_products' | t }}</a></li>
      {%- endif -%}
      <li><span aria-current="page">{{ product.title | escape }}</span></li>
    {%- elsif crumb_collection != blank -%}
      <li><span aria-current="page">{{ crumb_collection.title | escape }}</span></li>
    {%- endif -%}
  </ol>
</nav>
