{%- doc -%}
  Emits the font faces and the CSS custom properties derived from the theme settings: colors, color schemes, fonts, text presets, buttons, inputs, shade swatches and shape.
{%- enddoc -%}
{%- liquid
  assign accent = settings.color_primary | default: '#9b4a63'
  assign accent_deep = accent | color_darken: 12
  assign on_accent = '#ffffff'
  assign accent_brightness = accent | color_brightness
  if accent_brightness > 175
    assign on_accent = '#33252b'
  endif
  assign ink = settings.color_text | default: '#33252b'
  assign fonts_used = settings.type_body_font | append: ' ' | append: settings.type_heading_font | append: ' ' | append: settings.type_accent_font
  assign preset_ids = 'paragraph,h1,h2,h3,h4,h5,h6' | split: ','
-%}
<style data-serre-fonts>
  @font-face { font-family: 'Serre Playfair'; src: url({{ 'font-playfair-display.woff2' | asset_url }}) format('woff2'); font-weight: 400 900; font-display: swap; }
  @font-face { font-family: 'Serre Manrope'; src: url({{ 'font-manrope.woff2' | asset_url }}) format('woff2'); font-weight: 200 800; font-display: swap; }
  @font-face { font-family: 'Serre Lora'; src: url({{ 'font-lora.woff2' | asset_url }}) format('woff2'); font-weight: 400 700; font-display: swap; }
</style>
<style data-serre-variables>
  :root {
    --v-accent: {{ accent }};
    --v-accent-deep: {{ accent_deep }};
    --v-accent-soft: {{ accent | color_modify: 'alpha', 0.12 }};
    --v-on-accent: {{ on_accent }};
    --v-bg: {{ settings.color_background | default: '#fbf6f3' }};
    --v-surface: {{ settings.color_surface | default: '#f4e9e6' }};
    --v-card: {{ settings.color_card | default: '#ffffff' }};
    --v-ink: {{ ink }};
    --v-muted: {{ ink | color_modify: 'alpha', 0.72 }};
    --v-line: {{ ink | color_modify: 'alpha', 0.14 }};
    --v-sale: {{ settings.color_sale | default: '#a8322d' }};
    --f-body: {% render 'font-stack', font: settings.type_body_font %};
    --f-heading: {% render 'font-stack', font: settings.type_heading_font %};
    --f-accent: {% render 'font-stack', font: settings.type_accent_font %};
    --font-size-base: {{ settings.type_base_size | default: 16 }}px;
    --page-width: {{ settings.page_width | default: 1240 }}px;
    --round: {{ settings.corner_radius | default: 24 }}px;
    --round-sm: {{ settings.corner_radius | default: 24 | divided_by: 2 }}px;
    --pill: {{ settings.button_radius | default: 999 }}px;
    --arch: calc(var(--round) * 6);
    --logo-width: {{ settings.logo_width | default: 140 }}px;
    --space: {{ settings.section_spacing | default: 80 }}px;
    --card-ratio: {% case settings.card_image_ratio %}{% when 'square' %}1 / 1{% when 'landscape' %}4 / 3{% else %}4 / 5{% endcase %};
    --btn-radius: {{ settings.button_radius | default: 999 }}px;
    --btn-border: {{ settings.button_border_width | default: 1 }}px;
    --btn-height: {{ settings.button_height | default: 48 }}px;
    --btn-transform: {% if settings.button_uppercase %}uppercase{% else %}none{% endif %};
    --btn-font: var(--f-{{ settings.button_font | default: 'body' }});
    --input-radius: {{ settings.input_radius | default: 16 }}px;
    --input-border: {{ settings.input_border_width | default: 1 }}px;
    --input-height: {{ settings.input_height | default: 48 }}px;
    --badge-sold-out: {{ settings.badge_sold_out_color | default: '#4a5160' }};
    --anim: {{ settings.anim_duration | default: 400 }}ms;
    --icon-stroke: {{ settings.icon_stroke_width | default: 1.8 }};
    --icon-size: {{ settings.icon_size | default: 22 }}px;
    --swatch-size: {{ settings.swatch_size | default: 34 }}px;
    --swatch-radius: {% case settings.swatch_shape %}{% when 'square' %}4px{% when 'rounded' %}10px{% else %}999px{% endcase %};
    {%- for id in preset_ids %}
      {%- assign k_font = 'preset_' | append: id | append: '_font' -%}
      {%- assign k_size = 'preset_' | append: id | append: '_size' -%}
      {%- assign k_weight = 'preset_' | append: id | append: '_weight' -%}
      {%- assign k_lh = 'preset_' | append: id | append: '_line_height' -%}
      {%- assign k_case = 'preset_' | append: id | append: '_case' -%}
      {%- if settings[k_size] != blank %}
    --p-{{ id }}-font: var(--f-{{ settings[k_font] | default: 'body' }});
    --p-{{ id }}-size: calc(var(--font-size-base) * {{ settings[k_size] | divided_by: 100.0 }});
    --p-{{ id }}-weight: {{ settings[k_weight] | default: 400 }};
    --p-{{ id }}-lh: {{ settings[k_lh] | default: 130 | divided_by: 100.0 }};
    --p-{{ id }}-case: {{ settings[k_case] | default: 'none' }};
      {%- endif %}
    {%- endfor %}
  }
  {%- for scheme in settings.color_schemes %}
    {%- assign sid = scheme[0] -%}
    {%- assign sv = scheme[1].settings %}
  .color-{{ sid }} {
    --v-bg: {{ sv.background | default: '#fbf6f3' }};
    --v-ink: {{ sv.text | default: '#33252b' }};
    --v-surface: {{ sv.surface | default: sv.background }};
    --v-line: {{ sv.border | default: '#e8d9d4' }};
    --v-accent: {{ sv.button | default: '#9b4a63' }};
    --v-accent-deep: {{ sv.button | default: '#9b4a63' | color_darken: 12 }};
    --v-accent-soft: {{ sv.button | default: '#9b4a63' | color_modify: 'alpha', 0.14 }};
    --v-on-accent: {{ sv.button_label | default: '#ffffff' }};
    --v-muted: {{ sv.text | default: '#33252b' | color_modify: 'alpha', 0.78 }};
  }
  {%- endfor %}
</style>
