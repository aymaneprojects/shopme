{%- doc -%}
  Round "back to top" button, shown once the page is scrolled (theme setting "Show a back to top button").
{%- enddoc -%}
{%- if settings.show_back_to_top -%}
  <button type="button" class="k-top" data-back-to-top aria-label="{{ 'general.back_to_top' | t }}">{% render 'icon', name: 'arrow-up', size: 20 %}</button>
{%- endif -%}
