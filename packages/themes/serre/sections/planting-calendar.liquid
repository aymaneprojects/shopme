{%- assign s = section.settings -%}
<div class="k-section k-cal {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head k-section__head--center">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
    <ol class="k-cal__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="k-season k-season--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="k-season__icon">{% render 'icon', name: b.icon, size: 22 %}</span>
          <h3 class="k-season__title">{{ b.title | escape }}</h3>
          <p class="k-season__months">{{ b.months | escape }}</p>
          <ul class="k-season__tasks" role="list">
            {%- if b.task_1 != blank -%}<li>{% render 'icon', name: 'check', size: 14 %} {{ b.task_1 | escape }}</li>{%- endif -%}
            {%- if b.task_2 != blank -%}<li>{% render 'icon', name: 'check', size: 14 %} {{ b.task_2 | escape }}</li>{%- endif -%}
            {%- if b.task_3 != blank -%}<li>{% render 'icon', name: 'check', size: 14 %} {{ b.task_3 | escape }}</li>{%- endif -%}
          </ul>
          {%- if b.link != blank -%}<a class="k-season__link" href="{{ b.link }}" aria-label="{{ b.title | escape }}">{% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.planting_calendar.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.planting_calendar.settings.eyebrow",
      "default": "Season by season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.planting_calendar.settings.heading",
      "default": "What to plant and when"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.planting_calendar.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "season",
      "name": "t:sections.planting_calendar.blocks.season.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.planting_calendar.blocks.season.settings.title",
          "default": "Spring"
        },
        {
          "type": "text",
          "id": "months",
          "label": "t:sections.planting_calendar.blocks.season.settings.months",
          "default": "March to May"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.planting_calendar.blocks.season.settings.icon",
          "options": [
            {
              "value": "leaf",
              "label": "t:sections.planting_calendar.blocks.season.options.icon.leaf"
            },
            {
              "value": "sun",
              "label": "t:sections.planting_calendar.blocks.season.options.icon.sun"
            },
            {
              "value": "drop",
              "label": "t:sections.planting_calendar.blocks.season.options.icon.drop"
            },
            {
              "value": "moon",
              "label": "t:sections.planting_calendar.blocks.season.options.icon.moon"
            }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "task_1",
          "label": "t:sections.planting_calendar.blocks.season.settings.task_1",
          "default": "Sow seeds indoors"
        },
        {
          "type": "text",
          "id": "task_2",
          "label": "t:sections.planting_calendar.blocks.season.settings.task_2",
          "default": "Repot houseplants"
        },
        {
          "type": "text",
          "id": "task_3",
          "label": "t:sections.planting_calendar.blocks.season.settings.task_3",
          "default": "Prune climbers"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.planting_calendar.blocks.season.settings.link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.planting_calendar.presets.planting_calendar",
      "blocks": [
        {
          "type": "season"
        },
        {
          "type": "season"
        },
        {
          "type": "season"
        },
        {
          "type": "season"
        }
      ]
    }
  ]
}
{% endschema %}
