{%- assign s = section.settings -%}
<div class="k-section k-care {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="page-width">
    <div class="k-section__head">
      {%- if s.eyebrow != blank -%}<p class="k-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="k-section__title">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
    <ul class="k-care__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign pic = b.image | default: b.product.featured_image -%}
        {%- assign name = b.title | default: b.product.title -%}
        <li class="k-plant" {{ block.shopify_attributes }}>
          <a class="k-plant__media" href="{{ b.product.url | default: routes.all_products_collection_url }}">
            {%- if pic != blank -%}{{ pic | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 520, 700', sizes: '(min-width: 990px) 22vw, 45vw', alt: name }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'k-plant__placeholder' }}{%- endif -%}
          </a>
          <div class="k-plant__body">
            <h3 class="k-plant__name">{{ name | escape }}</h3>
            <dl class="k-plant__meters">
              <div><dt>{% render 'icon', name: 'sun', size: 16 %} {{ s.light_label | escape }}</dt><dd class="k-dots" aria-label="{{ b.light }} / 3">{%- for i in (1..3) -%}<span class="k-dot{% if i <= b.light %} is-on{% endif %}"></span>{%- endfor -%}</dd></div>
              <div><dt>{% render 'icon', name: 'drop', size: 16 %} {{ s.water_label | escape }}</dt><dd class="k-dots" aria-label="{{ b.water }} / 3">{%- for i in (1..3) -%}<span class="k-dot{% if i <= b.water %} is-on{% endif %}"></span>{%- endfor -%}</dd></div>
            </dl>
            {%- if b.note != blank -%}<p class="k-plant__note">{{ b.note | escape }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.care_levels.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.care_levels.settings.eyebrow",
      "default": "Easy to live with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.care_levels.settings.heading",
      "default": "How much care does it need?"
    },
    {
      "type": "text",
      "id": "light_label",
      "label": "t:sections.care_levels.settings.light_label",
      "default": "Light"
    },
    {
      "type": "text",
      "id": "water_label",
      "label": "t:sections.care_levels.settings.water_label",
      "default": "Water"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.care_levels.settings.color_scheme"
    }
  ],
  "blocks": [
    {
      "type": "plant",
      "name": "t:sections.care_levels.blocks.plant.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.care_levels.blocks.plant.settings.product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.care_levels.blocks.plant.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.care_levels.blocks.plant.settings.title"
        },
        {
          "type": "range",
          "id": "light",
          "label": "t:sections.care_levels.blocks.plant.settings.light",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 2
        },
        {
          "type": "range",
          "id": "water",
          "label": "t:sections.care_levels.blocks.plant.settings.water",
          "min": 1,
          "max": 3,
          "step": 1,
          "default": 2
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:sections.care_levels.blocks.plant.settings.note",
          "default": "Water when the top soil is dry."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:sections.care_levels.presets.care_levels",
      "blocks": [
        {
          "type": "plant"
        },
        {
          "type": "plant"
        }
      ]
    }
  ]
}
{% endschema %}
