{%- assign s = section.settings -%}
<div class="page-width{% if s.width != 'page' %} page-width--narrow{% endif %} section-pad customer customer--{{ s.align | default: 'left' }} {% render 'scheme-class', scheme: s.color_scheme %}">
  <h1 class="page-title">{%- if s.heading != blank -%}{{ s.heading | escape }}{%- else -%}{{ 'customer.activate.title' | t }}{%- endif -%}</h1>
  {%- if s.text != blank -%}<div class="rte customer__intro">{{ s.text }}</div>{%- else -%}<p>{{ 'customer.activate.text' | t }}</p>{%- endif -%}
  {%- form 'activate_customer_password', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="ActivatePassword">{{ 'customer.password' | t }}</label>
      <input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" minlength="8" required>
    </div>
    <div class="field">
      <label for="ActivatePasswordConfirmation">{{ 'customer.password_confirmation' | t }}</label>
      <input id="ActivatePasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="8" required>
    </div>
    <div class="customer__actions"><button class="button" type="submit">{{ 'customer.activate.submit' | t }}</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_activate_account.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.customer.headers.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.customer.settings.heading",
      "info": "t:sections.customer.info.heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.customer.settings.text",
      "info": "t:sections.customer.info.text_default"
    },
    {
      "type": "header",
      "content": "t:sections.customer.headers.layout"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.customer.settings.align",
      "variant": "segmented",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:shared.left"
        },
        {
          "value": "center",
          "label": "t:shared.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.customer.settings.width",
      "variant": "segmented",
      "default": "narrow",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.customer.options.width.narrow"
        },
        {
          "value": "page",
          "label": "t:sections.customer.options.width.page"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ]
}
{% endschema %}
