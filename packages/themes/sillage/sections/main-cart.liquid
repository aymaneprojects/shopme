<div class="page-width k-cart" data-cart-region data-section-id="{{ section.id }}">
  <h1 class="k-listing__title k-cart__title">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="k-empty">
      {% render 'icon', name: 'bag', size: 48 %}
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    {% render 'free-shipping-bar' %}
    {%- form 'cart', cart, id: 'cart-form', class: 'k-cart__form' -%}
      <div class="k-cart__layout">
        <ul class="k-cart__lines" role="list">
          {%- for item in cart.items -%}
            <li class="k-cartline" data-line="{{ forloop.index }}">
              {%- if settings.cart_show_thumbnails != false -%}
                <a class="k-cartline__image" href="{{ item.url }}">
                  {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'k-line__placeholder' }}{%- endif -%}
                </a>
              {%- endif -%}
              <div class="k-cartline__info">
                {%- if settings.cart_show_vendor and item.vendor != blank -%}<p class="k-line__vendor">{{ item.vendor | escape }}</p>{%- endif -%}
                <a class="k-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  {%- for option in item.options_with_values -%}<p class="k-line__meta">{{ option.name | escape }}: {{ option.value | escape }}</p>{%- endfor -%}
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  {%- assign per_delivery = item.selling_plan_allocation.per_delivery_price | money -%}
                  <p class="k-line__plan">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
                  <p class="k-line__meta">{{ 'cart.recurring' | t: price: per_delivery }}</p>
                {%- endif -%}
                <p class="k-line__meta">
                  {%- if item.original_price != item.final_price -%}<s>{{ item.original_price | money }}</s> {% endif -%}
                  {{ item.final_price | money }}
                </p>
                {%- for allocation in item.line_level_discount_allocations -%}
                  <p class="k-line__meta">{{ 'cart.discount' | t }}: {{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</p>
                {%- endfor -%}
                <a class="k-link-btn" href="{{ item.url_to_remove }}" data-remove-line="{{ forloop.index }}">{{ 'cart.remove' | t }}</a>
              </div>
              <div class="k-qty">
                <button type="button" class="k-qty__btn" data-qty-step="-1" data-line="{{ forloop.index }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus', size: 14 %}</button>
                <input class="k-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-line-qty data-line="{{ forloop.index }}" aria-label="{{ 'accessibility.quantity' | t }}">
                <button type="button" class="k-qty__btn" data-qty-step="1" data-line="{{ forloop.index }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus', size: 14 %}</button>
              </div>
              <p class="k-cartline__total">{{ item.final_line_price | money }}</p>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="k-summary" aria-label="{{ 'cart.summary' | t }}">
          <h2>{{ 'cart.summary' | t }}</h2>
          {%- if settings.cart_show_note != false -%}
            <label class="k-summary__note">
              <span>{{ 'cart.note' | t }}</span>
              <textarea name="note" rows="3">{{ cart.note }}</textarea>
            </label>
          {%- endif -%}
          {%- for application in cart.cart_level_discount_applications -%}
            <p class="k-summary__row"><span>{{ 'cart.discount' | t }}: {{ application.title | escape }}</span> <span>-{{ application.total_allocated_amount | money }}</span></p>
          {%- endfor -%}
          <p class="k-summary__row k-summary__total"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="k-drawer__hint">{{ 'cart.taxes_shipping' | t }}</p>
          <noscript><button type="submit" class="button button--outline button--block" name="update">{{ 'cart.update' | t }}</button></noscript>
          <a class="button button--block" href="/checkout">{{ 'cart.checkout' | t }}</a>
          {%- if settings.cart_show_continue != false -%}
            <a class="k-link-btn k-summary__continue" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
          {%- endif -%}
        </aside>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "settings": []
}
{% endschema %}
