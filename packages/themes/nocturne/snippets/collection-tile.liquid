{%- doc -%}
  Tile linking to a collection.
  @param {collection} tile_collection - the collection to show
  @param {boolean} [show_count] - show the number of products
  @param {number} [index] - position in the list (for numbered styles)
{%- enddoc -%}
<a class="tile" href="{{ tile_collection.url }}">
  <span class="tile__media">
    {%- if tile_collection.image -%}
      {%- assign focal = '' -%}
      {%- if tile_collection.image.presentation.focal_point != blank -%}{%- assign focal = 'object-position: ' | append: tile_collection.image.presentation.focal_point -%}{%- endif -%}
      {{ tile_collection.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 33vw, 100vw', alt: '', style: focal }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'tile__placeholder' }}
    {%- endif -%}
  </span>
  <span class="tile__text">
    {%- if index -%}<span class="tile__index" aria-hidden="true">{% if index < 10 %}0{% endif %}{{ index }}</span>{%- endif -%}
    <span class="tile__title">{{ tile_collection.title | escape }}</span>
    {%- if show_count -%}<span class="tile__count">{{ 'collection.product_count' | t: count: tile_collection.products_count }}</span>{%- endif -%}
  </span>
</a>
