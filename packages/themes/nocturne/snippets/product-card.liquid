{%- doc -%}
  Product card used in grids: portrait image that reveals the second photo on hover, then vendor, title and price.
  @param {product} card_product - the product to show
  @param {number} [index] - position in the list
{%- enddoc -%}
{%- liquid
  assign image = card_product.featured_image
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: image.presentation.focal_point
  endif
  assign second = card_product.images[1]
  assign second_focal = ''
  if second.presentation.focal_point != blank
    assign second_focal = 'object-position: ' | append: second.presentation.focal_point
  endif
-%}
<article class="pcard pcard--align-{{ settings.card_text_align | default: 'center' }}{% unless card_product.available %} is-sold-out{% endunless %}">
  <a class="pcard__media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{ image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '300, 450, 600, 720', sizes: '(min-width: 990px) 25vw, 50vw', alt: card_product.title, class: 'pcard__img', style: focal }}
      {%- if settings.card_hover_image and second -%}
        {{ second | image_url: width: 720 | image_tag: loading: 'lazy', widths: '300, 450, 600, 720', sizes: '(min-width: 990px) 25vw, 50vw', alt: '', class: 'pcard__img pcard__img--hover', style: second_focal }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'pcard__placeholder' }}
    {%- endif -%}
  </a>
  <div class="pcard__badges pcard__badges--{{ settings.badge_position | default: 'top-left' }}">{% render 'product-badges', product: card_product, limit: 2 %}</div>
  <div class="pcard__body">
    {%- if settings.show_vendor and card_product.vendor != blank -%}
      <p class="pcard__vendor">{{ card_product.vendor | escape }}</p>
    {%- endif -%}
    <h3 class="pcard__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    {% render 'price', product: card_product %}
  </div>
</article>
