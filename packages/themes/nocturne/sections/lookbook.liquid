{%- assign s = section.settings -%}
<div class="section-pad lookbook {% render 'scheme-class', scheme: s.color_scheme %}{% if s.texture != blank and s.texture != 'none' %} texture texture--{{ s.texture }}{% endif %}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-title">{{ s.heading | escape }}</h2>{%- endif -%}
    </div>
    <div class="lookbook__grid lookbook__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign picture = block.settings.image | default: c.image
          assign title = block.settings.label | default: c.title
          assign link = block.settings.link | default: c.url | default: routes.all_products_collection_url
          assign focal = ''
          if picture.presentation.focal_point != blank
            assign focal = 'object-position: ' | append: picture.presentation.focal_point
          endif
        -%}
        <a class="lookbook__panel lookbook__panel--{{ forloop.index }}" href="{{ link }}" {{ block.shopify_attributes }}>
          <span class="lookbook__media">
            {%- if picture -%}
              {{ picture | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 990px) 40vw, 100vw', alt: '', style: focal }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'lookbook__placeholder' }}
            {%- endif -%}
          </span>
          <span class="lookbook__text">
            <span class="lookbook__num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <span class="lookbook__title">{{ title | escape }}</span>
            {%- if block.settings.caption != blank -%}<span class="lookbook__caption">{{ block.settings.caption | escape }}</span>{%- endif -%}
            <span class="lookbook__cta">{{ 'general.discover' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.lookbook.name",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.lookbook.settings.eyebrow",
      "default": "Lookbook"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.lookbook.settings.heading",
      "default": "Three worlds, one signature"
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.lookbook.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.lookbook.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.lookbook.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.lookbook.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.lookbook.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "t:sections.lookbook.blocks.panel.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.lookbook.blocks.panel.settings.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.lookbook.blocks.panel.settings.label",
          "default": ""
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.lookbook.blocks.panel.settings.caption",
          "default": ""
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.lookbook.blocks.panel.settings.image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.lookbook.blocks.panel.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.lookbook.presets.lookbook",
      "category": "collection",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "caption": "A signature piece for every occasion."
          }
        },
        {
          "type": "panel",
          "settings": {
            "caption": "Precision you can feel."
          }
        }
      ]
    }
  ]
}
{% endschema %}
