<div class="section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}{% if section.settings.texture != blank and section.settings.texture != 'none' %} texture texture--{{ section.settings.texture }}{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--stack">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <ul class="multicolumn multicolumn--{{ section.settings.columns }} multicolumn--{{ section.settings.align }}" role="list">
      {%- for block in section.blocks -%}
        <li class="multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="multicolumn__media">
              {%- assign focal = '' -%}
              {%- if block.settings.image.presentation.focal_point != blank -%}{%- assign focal = 'object-position: ' | append: block.settings.image.presentation.focal_point -%}{%- endif -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title, style: focal }}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="multicolumn__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<a class="link-arrow" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.multicolumn.settings.eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading",
      "default": ""
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.multicolumn.settings.columns",
      "options": [
        {
          "value": "2",
          "label": "t:sections.multicolumn.options.columns.2"
        },
        {
          "value": "3",
          "label": "t:sections.multicolumn.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.multicolumn.options.columns.4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.multicolumn.settings.align",
      "options": [
        {
          "value": "left",
          "label": "t:shared.left"
        },
        {
          "value": "center",
          "label": "t:shared.center"
        }
      ],
      "default": "left",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.multicolumn.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.multicolumn.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.multicolumn.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.multicolumn.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title",
          "default": "Handcrafted"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text",
          "default": "<p>Finished by hand, one piece at a time.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.multicolumn",
      "category": "text",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Handcrafted",
            "text": "<p>Finished by hand, one piece at a time.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Responsibly sourced",
            "text": "<p>Recycled gold and traceable stones.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Made to last",
            "text": "<p>Serviced for life by our atelier.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
