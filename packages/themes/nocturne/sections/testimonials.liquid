<div class="section-pad testimonials-section {% render 'scheme-class', scheme: section.settings.color_scheme %}{% if section.settings.texture != blank and section.settings.texture != 'none' %} texture texture--{{ section.settings.texture }}{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.layout == 'carousel' -%}{%- render 'carousel-arrows' -%}{%- endif -%}
    </div>
    <ul class="testimonials testimonials--{{ section.settings.layout }}"{% if section.settings.layout == 'carousel' %} data-carousel{% endif %} role="list">
      {%- for block in section.blocks -%}
        <li class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <p class="testimonial__stars" role="img" aria-label="{{ block.settings.rating }} / 5">{%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}</p>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>
          <div class="testimonial__author">
            {%- if block.settings.avatar -%}{{ block.settings.avatar | image_url: width: 120 | image_tag: class: 'testimonial__avatar', loading: 'lazy', alt: block.settings.author }}{%- endif -%}
            <p><strong>{{ block.settings.author | escape }}</strong>{%- if block.settings.role != blank -%}<span class="testimonial__role">{{ block.settings.role | escape }}</span>{%- endif -%}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.testimonials.settings.eyebrow",
      "default": "Press and clients"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading",
      "default": "In their words"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.testimonials.settings.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.testimonials.options.layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.testimonials.options.layout.carousel"
        }
      ],
      "default": "grid",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.testimonials.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.testimonials.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.testimonials.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.testimonials.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.testimonials.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote",
          "default": "A quiet masterpiece: nothing is shouted, everything is felt."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author",
          "default": "Helena V."
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.testimonials.blocks.testimonial.settings.role",
          "default": "Collector, Geneva"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.testimonial.settings.avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.testimonials",
      "category": "text",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "A quiet masterpiece: nothing is shouted, everything is felt.",
            "author": "Helena V.",
            "role": "Collector, Geneva"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "The finishing rivals houses three times its size.",
            "author": "The Watch Review",
            "role": "Independent magazine"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "My engagement ring arrived like a small ceremony.",
            "author": "Julien M.",
            "role": "Client since 2019"
          }
        }
      ]
    }
  ]
}
{% endschema %}
