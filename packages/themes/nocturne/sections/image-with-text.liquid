{%- assign s = section.settings -%}
<div class="section-pad split split--{{ s.layout }} split--{{ s.image_ratio }} {% render 'scheme-class', scheme: s.color_scheme %}{% if s.texture != blank and s.texture != 'none' %} texture texture--{{ s.texture }}{% endif %}">
  <div class="page-width split__inner">
    <div class="split__media">
      {%- if s.video_url != blank -%}
        {%- render 'media', media_type: 'video', video_url: s.video_url, controls: false, image: s.image -%}
      {%- elsif s.image -%}
        {%- render 'media', media_type: 'image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw' -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split__placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__body">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}<a class="button button--outline" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:sections.image_with_text.settings.video_url"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.image_with_text.settings.eyebrow",
      "default": "The atelier"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_with_text.settings.heading",
      "default": "Made by hand, finished by eye"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image_with_text.settings.text",
      "default": "<p>Our craftsmen spend up to three hundred hours on a single piece. Nothing leaves until it is flawless.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.settings.button_label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.settings.button_link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout",
      "options": [
        {
          "value": "left",
          "label": "t:shared.left"
        },
        {
          "value": "right",
          "label": "t:shared.right"
        }
      ],
      "default": "left",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image_with_text.settings.image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.image_with_text.options.image_ratio.landscape"
        },
        {
          "value": "portrait",
          "label": "t:sections.image_with_text.options.image_ratio.portrait"
        },
        {
          "value": "square",
          "label": "t:sections.image_with_text.options.image_ratio.square"
        }
      ],
      "default": "portrait",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.image_with_text.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.image_with_text.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.image_with_text.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.image_with_text.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.image_with_text.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.image_with_text",
      "category": "image"
    }
  ]
}
{% endschema %}
