<div class="section-pad faq {% render 'scheme-class', scheme: section.settings.color_scheme %}{% if section.settings.texture != blank and section.settings.texture != 'none' %} texture texture--{{ section.settings.texture }}{% endif %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item"{% if section.settings.open_first and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
          <summary class="accordion__summary"><span>{{ block.settings.heading | escape }}</span>{% render 'icon', name: 'chevron-down' %}</summary>
          <div class="accordion__body rte">{{ block.settings.text }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collapsible_content.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.collapsible_content.settings.eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collapsible_content.settings.heading",
      "default": "Questions, answered"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.collapsible_content.settings.open_first",
      "default": false
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.collapsible_content.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.collapsible_content.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.collapsible_content.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.collapsible_content.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.collapsible_content.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.collapsible_content.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.collapsible_content.blocks.row.settings.heading",
          "default": "Are your pieces numbered and certified?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.collapsible_content.blocks.row.settings.text",
          "default": "<p>Yes. Each piece carries its serial number and is delivered with a signed certificate of authenticity.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible_content.presets.collapsible_content",
      "category": "text",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "Are your pieces numbered and certified?",
            "text": "<p>Yes. Each piece carries its serial number and is delivered with a signed certificate of authenticity.</p>"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "Can I have a piece engraved?",
            "text": "<p>Engraving is complimentary. Add your wording at checkout and our engraver will confirm it with you.</p>"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "How do I care for my jewelry or watch?",
            "text": "<p>Keep each piece in its pouch, away from moisture. We offer a free annual service for ten years.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
