{%- if section.settings.show and section.settings.text != blank -%}
  <div class="announcement {% render 'scheme-class', scheme: section.settings.color_scheme %}" role="region" aria-label="{{ section.settings.text | strip_html | escape }}">
    <div class="page-width announcement__inner">
      {%- if section.settings.link != blank -%}
        <a class="announcement__text" href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p class="announcement__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "div",
  "class": "announcement-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "t:sections.announcement_bar.settings.show",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.settings.text",
      "default": "Complimentary shipping and engraving on every order"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.settings.link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement_bar.presets.announcement_bar",
      "category": "banner"
    }
  ]
}
{% endschema %}
