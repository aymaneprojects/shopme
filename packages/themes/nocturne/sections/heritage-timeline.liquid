{%- assign s = section.settings -%}
<div class="section-pad timeline {% render 'scheme-class', scheme: s.color_scheme %}{% if s.texture != blank and s.texture != 'none' %} texture texture--{{ s.texture }}{% endif %}">
  <div class="page-width">
    <div class="section-head section-head--center">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}<h2 class="section-title">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="section-lead">{{ s.text | escape }}</p>{%- endif -%}
    </div>
    <ol class="timeline__list" role="list">
      {%- for block in section.blocks -%}
        <li class="timeline__item" {{ block.shopify_attributes }}>
          <p class="timeline__year">{{ block.settings.year | escape }}</p>
          <span class="timeline__dot" aria-hidden="true"></span>
          <h3 class="timeline__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<p class="timeline__text">{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.heritage_timeline.name",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.heritage_timeline.settings.eyebrow",
      "default": "Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.heritage_timeline.settings.heading",
      "default": "A house of patience"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.heritage_timeline.settings.text",
      "default": ""
    },
    {
      "type": "select",
      "id": "texture",
      "label": "t:sections.heritage_timeline.settings.texture",
      "options": [
        {
          "value": "none",
          "label": "t:sections.heritage_timeline.options.texture.none"
        },
        {
          "value": "lines",
          "label": "t:sections.heritage_timeline.options.texture.lines"
        },
        {
          "value": "noir",
          "label": "t:sections.heritage_timeline.options.texture.noir"
        },
        {
          "value": "guilloche",
          "label": "t:sections.heritage_timeline.options.texture.guilloche"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "t:sections.heritage_timeline.blocks.milestone.name",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "t:sections.heritage_timeline.blocks.milestone.settings.year",
          "default": "1887"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.heritage_timeline.blocks.milestone.settings.title",
          "default": "The first workbench"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.heritage_timeline.blocks.milestone.settings.text",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.heritage_timeline.presets.heritage_timeline",
      "category": "text",
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "1887",
            "title": "The first workbench",
            "text": "A single bench and a promise: nothing leaves unfinished."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "1924",
            "title": "The Calibre No. 1",
            "text": "Our first in-house movement, still running today."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "1968",
            "title": "The jewelry atelier",
            "text": "Gem-setting joins watchmaking under one roof."
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2024",
            "title": "Carbon-neutral workshop",
            "text": "Recycled gold, traceable stones, repairs for life."
          }
        }
      ]
    }
  ]
}
{% endschema %}
