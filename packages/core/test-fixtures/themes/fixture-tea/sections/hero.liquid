<section class="hero">
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.text }}</p>
  <a class="btn" href="/collections/all">{{ section.settings.button }}</a>
</section>
<section class="grid">
  {%- for product in collections.all.products limit: 4 -%}
    <a href="{{ product.url }}">
      <div class="ph">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 480 }}" alt="{{ product.featured_image.alt | escape }}" loading="eager">{% endif %}</div>
      <h3>{{ product.title }}</h3>
      <span>{{ product.price | money }}</span>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh tea, delivered" },
    { "type": "text", "id": "text", "label": "Text", "default": "Small batches, steeped slowly." },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop the teas" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
