<div class="page-width section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  <div class="section-head">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.layout == 'carousel' -%}{%- render 'carousel-arrows' -%}{%- endif -%}
  </div>
  <ul class="testimonials testimonials--{{ section.settings.layout }}"{% if section.settings.layout == 'carousel' %} data-carousel{% endif %} role="list">
    {%- for block in section.blocks -%}
      <li class="testimonial" {{ block.shopify_attributes }}>
        {%- if block.settings.rating > 0 -%}
          <p class="testimonial__stars" aria-label="{{ block.settings.rating }} / 5">{%- for i in (1..5) -%}<span class="{% if i <= block.settings.rating %}is-on{% endif %}" aria-hidden="true">&#9733;</span>{%- endfor -%}</p>
        {%- endif -%}
        <blockquote class="testimonial__quote">{{ block.settings.quote | escape }}</blockquote>
        <div class="testimonial__author">
          {%- if block.settings.avatar -%}{{ block.settings.avatar | image_url: width: 120 | image_tag: class: 'testimonial__avatar', loading: 'lazy', alt: block.settings.author }}{%- endif -%}
          <p><strong>{{ block.settings.author | escape }}</strong>{%- if block.settings.role != blank -%}<br><span class="customer__muted">{{ block.settings.role | escape }}</span>{%- endif -%}</p>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading",
      "default": "What our customers say"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.testimonials.settings.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.testimonials.options.layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.testimonials.options.layout.carousel"
        }
      ],
      "default": "grid",
      "variant": "segmented"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote",
          "default": "Wonderful products and fast delivery. I will order again."
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author",
          "default": "Alex"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.testimonials.blocks.testimonial.settings.role"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "t:sections.testimonials.blocks.testimonial.settings.avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:sections.testimonials.blocks.testimonial.settings.rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Sam",
            "quote": "Great quality and friendly support."
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "author": "Robin",
            "quote": "Exactly what I was looking for."
          }
        }
      ]
    }
  ]
}
{% endschema %}
