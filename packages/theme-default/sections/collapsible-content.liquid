<div class="page-width page-width--narrow section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  {%- if section.settings.heading != blank -%}<div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
  <div class="accordion">
    {%- for block in section.blocks -%}
      <details class="accordion__item"{% if section.settings.open_first and forloop.first %} open{% endif %} {{ block.shopify_attributes }}>
        <summary class="accordion__summary"><span>{{ block.settings.heading | escape }}</span>{% render 'icon', name: 'chevron-down' %}</summary>
        <div class="accordion__body rte">{{ block.settings.text }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collapsible_content.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collapsible_content.settings.heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.collapsible_content.settings.open_first",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.collapsible_content.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.collapsible_content.blocks.row.settings.heading",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.collapsible_content.blocks.row.settings.text",
          "default": "<p>The answer goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible_content.presets.collapsible_content",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "heading": "How long does shipping take?"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "What is your return policy?"
          }
        },
        {
          "type": "row",
          "settings": {
            "heading": "How can I contact you?"
          }
        }
      ]
    }
  ]
}
{% endschema %}
