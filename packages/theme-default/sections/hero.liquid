{%- liquid
  assign align = section.settings.text_align
  assign has_media = false
  if section.settings.media_type == 'video' and section.settings.video_url != blank
    assign has_media = true
  elsif section.settings.image
    assign has_media = true
  endif
-%}
<div class="hero hero--{{ section.settings.height }} hero--{{ align }} hero--v-{{ section.settings.vertical_align }} hero--{{ section.settings.direction }}{% unless has_media %} hero--no-image{% endunless %}" style="--hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }};">
  {%- if has_media -%}
    <div class="hero__media">
      {%- render 'media', media_type: section.settings.media_type, image: section.settings.image, mobile_image: section.settings.mobile_image, use_mobile: section.settings.mobile_media, video_url: section.settings.video_url, eager: true, sizes: '100vw' -%}
    </div>
  {%- endif -%}
  {%- render 'section-link', url: section.settings.section_link, new_tab: section.settings.section_link_new_tab, label: section.settings.heading -%}
  <div class="page-width hero__content">
    <div class="hero__text-group">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero__text">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <a class="button button--light" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.hero.headers.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading",
      "default": "Discover what is new"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.hero.settings.subheading",
      "default": "Hand-picked products, delivered to your door."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.hero.settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:sections.hero.options.media_type.image"
        },
        {
          "value": "video",
          "label": "t:sections.hero.options.media_type.video"
        }
      ],
      "default": "image",
      "variant": "segmented"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "t:sections.hero.settings.video_url",
      "info": "t:sections.hero.info.video_url",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "mobile_media",
      "label": "t:sections.hero.settings.mobile_media",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.hero.settings.mobile_image",
      "visible_if": "{{ section.settings.mobile_media and section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height",
      "options": [
        {
          "value": "small",
          "label": "t:sections.hero.options.height.small"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.options.height.medium"
        },
        {
          "value": "large",
          "label": "t:sections.hero.options.height.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.hero.settings.text_align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.hero.options.text_align.left"
        },
        {
          "value": "center",
          "label": "t:sections.hero.options.text_align.center"
        }
      ],
      "default": "left",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "t:sections.hero.settings.vertical_align",
      "options": [
        {
          "value": "top",
          "label": "t:sections.hero.options.vertical_align.top"
        },
        {
          "value": "middle",
          "label": "t:sections.hero.options.vertical_align.middle"
        },
        {
          "value": "bottom",
          "label": "t:sections.hero.options.vertical_align.bottom"
        }
      ],
      "default": "middle",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.hero.settings.direction",
      "options": [
        {
          "value": "vertical",
          "label": "t:sections.hero.options.direction.vertical"
        },
        {
          "value": "horizontal",
          "label": "t:sections.hero.options.direction.horizontal"
        }
      ],
      "default": "vertical",
      "variant": "segmented"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.hero.settings.overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.hero.headers.link"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "t:sections.hero.settings.section_link",
      "info": "t:sections.hero.info.section_link"
    },
    {
      "type": "checkbox",
      "id": "section_link_new_tab",
      "label": "t:sections.hero.settings.section_link_new_tab",
      "default": false,
      "visible_if": "{{ section.settings.section_link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.hero"
    },
    {
      "name": "t:sections.hero.presets.hero_bottom",
      "settings": {
        "vertical_align": "bottom",
        "height": "large"
      }
    }
  ]
}
{% endschema %}
