<div class="page-width section-pad cart" data-cart-section data-section-id="{{ section.id }}">
  <h1 class="page-title">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="cart__empty">
      <p>{{ 'cart.empty' | t }}</p>
      <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    {%- form 'cart', cart, id: 'cart-form', class: 'cart__form' -%}
      <table class="cart__table">
        <thead>
          <tr>
            <th scope="col">{{ 'cart.product' | t }}</th>
            <th scope="col" class="cart__col-qty">{{ 'cart.quantity' | t }}</th>
            <th scope="col" class="cart__col-total">{{ 'cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr class="cart__item" data-line="{{ forloop.index }}">
              <td class="cart__product">
                <a class="cart__image" href="{{ item.url }}">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'cart__placeholder' }}
                  {%- endif -%}
                </a>
                <div>
                  <a class="cart__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    {%- for option in item.options_with_values -%}
                      <p class="cart__option">{{ option.name | escape }}: {{ option.value | escape }}</p>
                    {%- endfor -%}
                  {%- endunless -%}
                  <p class="cart__unit">
                    {%- if item.original_price != item.final_price -%}<s class="cart__was">{{ item.original_price | money }}</s> {% endif -%}
                    {{ item.final_price | money }}
                  </p>
                  {%- for allocation in item.line_level_discount_allocations -%}
                    <p class="cart__option">{{ 'cart.discount' | t }}: {{ allocation.discount_application.title | escape }} (-{{ allocation.amount | money }})</p>
                  {%- endfor -%}
                  <a class="cart__remove" href="{{ item.url_to_remove }}" data-remove-line="{{ forloop.index }}">{{ 'cart.remove' | t }}</a>
                </div>
              </td>
              <td class="cart__col-qty">
                <div class="quantity">
                  <button type="button" class="quantity__button" data-qty-step="-1" data-line="{{ forloop.index }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title }}">{% render 'icon', name: 'minus' %}</button>
                  <input class="quantity__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" data-line-qty data-line="{{ forloop.index }}" aria-label="{{ 'accessibility.quantity' | t }}">
                  <button type="button" class="quantity__button" data-qty-step="1" data-line="{{ forloop.index }}" aria-label="{{ 'cart.increase' | t: title: item.product.title }}">{% render 'icon', name: 'plus' %}</button>
                </div>
              </td>
              <td class="cart__col-total">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart__footer">
        <label class="cart__note">
          <span>{{ 'cart.note' | t }}</span>
          <textarea name="note" rows="3">{{ cart.note }}</textarea>
        </label>
        <div class="cart__summary">
          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="cart__discounts" role="list">
              {%- for application in cart.cart_level_discount_applications -%}
                <li><span>{{ 'cart.discount' | t }}: {{ application.title | escape }}</span> <span>-{{ application.total_allocated_amount | money }}</span></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <p class="cart__subtotal"><span>{{ 'cart.subtotal' | t }}</span> <strong>{{ cart.total_price | money_with_currency }}</strong></p>
          <p class="cart__hint">{{ 'cart.taxes_shipping' | t }}</p>
          <noscript><button type="submit" class="button button--outline" name="update">{{ 'cart.update' | t }}</button></noscript>
          <a class="button button--block" href="/checkout">{{ 'cart.checkout' | t }}</a>
        </div>
      </div>
    {%- endform -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "tag": "section", "settings": [] }
{% endschema %}
