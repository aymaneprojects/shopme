<div class="newsletter-section newsletter-section--{{ section.settings.align }} section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  <div class="page-width page-width--narrow">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
    {%- form 'customer', id: section.id, class: 'newsletter' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="{{ section.id }}-email">{{ 'newsletter.label' | t }}</label>
        <div class="newsletter__row">
          <input id="{{ section.id }}-email" class="search-form__input" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
          <button class="button" type="submit">{%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'newsletter.submit' | t }}{%- endif -%}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading",
      "default": "Subscribe to our emails"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter.settings.text",
      "default": "<p>Be the first to know about new collections and offers.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label",
      "info": "t:sections.newsletter.info.button_label"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.newsletter.settings.align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.newsletter.options.align.left"
        },
        {
          "value": "center",
          "label": "t:sections.newsletter.options.align.center"
        }
      ],
      "default": "center",
      "variant": "segmented"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.newsletter"
    }
  ]
}
{% endschema %}
