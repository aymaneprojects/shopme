{%- liquid
  assign blocks = section.blocks
  assign fallback = false
  if blocks.size == 0
    assign fallback = true
  endif
-%}
<div class="page-width section-pad">
  {%- if section.settings.heading != blank -%}
    <div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>
  {%- endif -%}
  <ul class="grid grid--3 collection-tiles" role="list">
    {%- if fallback -%}
      {%- for collection in collections limit: 3 -%}
        <li>{% render 'collection-tile', tile_collection: collection %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for block in blocks -%}
        {%- if block.settings.collection != blank -%}
          <li {{ block.shopify_attributes }}>{% render 'collection-tile', tile_collection: block.settings.collection %}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by collection" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [ { "type": "collection", "id": "collection", "label": "Collection" } ] }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
