{%- assign blocks = section.blocks -%}
{%- assign layout = section.settings.layout -%}
<div class="page-width section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  <div class="section-head">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if layout == 'carousel' -%}{%- render 'carousel-arrows' -%}{%- endif -%}
  </div>
  <ul class="collection-tiles collection-tiles--{{ layout }}{% if layout == 'grid' %} collection-tiles--cols-{{ section.settings.columns }}{% endif %}"{% if layout == 'carousel' %} data-carousel{% endif %} role="list">
    {%- if blocks.size == 0 -%}
      {%- for collection in collections limit: 5 -%}
        <li>{% render 'collection-tile', tile_collection: collection %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for block in blocks -%}
        {%- if block.settings.collection != blank -%}
          <li {{ block.shopify_attributes }}>{% render 'collection-tile', tile_collection: block.settings.collection %}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_list.settings.heading",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_list.settings.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.collection_list.options.layout.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.collection_list.options.layout.carousel"
        },
        {
          "value": "bento",
          "label": "t:sections.collection_list.options.layout.bento"
        },
        {
          "value": "editorial",
          "label": "t:sections.collection_list.options.layout.editorial"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.collection_list.settings.columns",
      "options": [
        {
          "value": "2",
          "label": "t:sections.collection_list.options.columns.2"
        },
        {
          "value": "3",
          "label": "t:sections.collection_list.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.collection_list.options.columns.4"
        }
      ],
      "default": "3",
      "visible_if": "{{ section.settings.layout == 'grid' }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_list.blocks.collection.settings.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.grid"
    },
    {
      "name": "t:sections.collection_list.presets.carousel",
      "settings": {
        "layout": "carousel"
      }
    },
    {
      "name": "t:sections.collection_list.presets.bento",
      "settings": {
        "layout": "bento"
      }
    },
    {
      "name": "t:sections.collection_list.presets.editorial",
      "settings": {
        "layout": "editorial"
      }
    }
  ]
}
{% endschema %}
