<div class="page-width section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  <div class="split split--image-{{ section.settings.layout }}{% unless section.settings.stack_on_mobile %} split--no-stack{% endunless %} split--{{ section.settings.direction }}" style="position: relative;">
    <div class="split__media">
      {%- if section.settings.media_type == 'video' and section.settings.video_url != blank -%}
        {%- render 'media', media_type: 'video', video_url: section.settings.video_url, controls: true -%}
      {%- elsif section.settings.image -%}
        {%- render 'media', media_type: 'image', image: section.settings.image, mobile_image: section.settings.mobile_image, use_mobile: section.settings.mobile_media, sizes: '(min-width: 750px) 50vw, 100vw' -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'split__placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__body">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- render 'section-link', url: section.settings.section_link, new_tab: section.settings.section_link_new_tab, label: section.settings.heading -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.image_with_text.headers.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:sections.image_with_text.settings.media_type",
      "options": [
        {
          "value": "image",
          "label": "t:sections.image_with_text.options.media_type.image"
        },
        {
          "value": "video",
          "label": "t:sections.image_with_text.options.media_type.video"
        }
      ],
      "default": "image",
      "variant": "segmented"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "t:sections.image_with_text.settings.video_url",
      "info": "t:sections.image_with_text.info.video_url",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "checkbox",
      "id": "mobile_media",
      "label": "t:sections.image_with_text.settings.mobile_media",
      "default": false,
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.image_with_text.settings.mobile_image",
      "visible_if": "{{ section.settings.mobile_media and section.settings.media_type == 'image' }}"
    },
    {
      "type": "checkbox",
      "id": "stack_on_mobile",
      "label": "t:sections.image_with_text.settings.stack_on_mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text.headers.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_with_text.settings.heading",
      "default": "Made with care"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.image_with_text.settings.text",
      "default": "<p>Pair an image with a short story about your products, your craft or your team.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_with_text.settings.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_with_text.settings.button_link"
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text.headers.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_with_text.settings.layout",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.options.layout.left"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.options.layout.right"
        }
      ],
      "default": "left",
      "variant": "segmented"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.image_with_text.settings.direction",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.image_with_text.options.direction.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:sections.image_with_text.options.direction.vertical"
        }
      ],
      "default": "horizontal",
      "variant": "segmented"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    },
    {
      "type": "header",
      "content": "t:sections.image_with_text.headers.link"
    },
    {
      "type": "url",
      "id": "section_link",
      "label": "t:sections.image_with_text.settings.section_link",
      "info": "t:sections.image_with_text.info.section_link"
    },
    {
      "type": "checkbox",
      "id": "section_link_new_tab",
      "label": "t:sections.image_with_text.settings.section_link_new_tab",
      "default": false,
      "visible_if": "{{ section.settings.section_link != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.image_with_text"
    }
  ]
}
{% endschema %}
