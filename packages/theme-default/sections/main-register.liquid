<div class="page-width page-width--narrow section-pad customer">
  <h1 class="page-title">{{ 'customer.register_page.title' | t }}</h1>
  {%- form 'create_customer', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
      <input id="RegisterFirstName" type="text" name="customer[first_name]" value="{{ form.first_name | escape }}" autocomplete="given-name">
    </div>
    <div class="field">
      <label for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
      <input id="RegisterLastName" type="text" name="customer[last_name]" value="{{ form.last_name | escape }}" autocomplete="family-name">
    </div>
    <div class="field">
      <label for="RegisterEmail">{{ 'customer.email' | t }}</label>
      <input id="RegisterEmail" type="email" name="customer[email]" value="{{ form.email | escape }}" autocomplete="email" autocapitalize="off" required>
    </div>
    <div class="field">
      <label for="RegisterPassword">{{ 'customer.password' | t }}</label>
      <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="8" required>
    </div>
    <label class="field field--check">
      <input type="checkbox" name="customer[accepts_marketing]" value="true">
      <span>{{ 'customer.register_page.marketing' | t }}</span>
    </label>
    <div class="customer__actions">
      <button class="button" type="submit">{{ 'customer.register_page.submit' | t }}</button>
    </div>
  {%- endform -%}
  <p class="customer__alt">{{ 'customer.register_page.have_account' | t }} <a href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a></p>
</div>

{% schema %}
{ "name": "Register", "tag": "section", "settings": [] }
{% endschema %}
