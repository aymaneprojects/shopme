{%- if section.settings.show and section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="{{ section.settings.text | strip_html | escape }}">
    <div class="page-width announcement__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement_bar.name",
  "tag": "div",
  "class": "announcement-section",
  "settings": [
    { "type": "checkbox", "id": "show", "label": "t:sections.announcement_bar.settings.show", "default": true },
    { "type": "text", "id": "text", "label": "t:sections.announcement_bar.settings.text", "default": "Welcome to our store" },
    { "type": "url", "id": "link", "label": "t:sections.announcement_bar.settings.link" }
  ],
  "presets": [{ "name": "t:sections.announcement_bar.name" }]
}
{% endschema %}
