{%- assign per_page = section.settings.products_per_page -%}
<div class="page-width section-pad">
  <header class="page-head">
    <h1 class="page-title">{{ collection.title | escape }}</h1>
    {%- if collection.description != blank -%}
      <div class="page-head__text rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  <form class="toolbar" method="get" action="{{ collection.url }}" data-auto-submit>
    <p class="toolbar__count">{{ 'collection.product_count' | t: count: collection.products_count }}</p>
    {%- for filter in collection.filters -%}
      {%- if filter.type == 'list' and filter.param_name == 'filter.v.availability' -%}
        <label class="toolbar__field">
          <span class="visually-hidden">{{ filter.label }}</span>
          <select name="{{ filter.param_name }}">
            <option value="">{{ filter.label }}</option>
            {%- for value in filter.values -%}
              <option value="{{ value.value }}"{% if value.active %} selected{% endif %}>{{ value.label }} ({{ value.count }})</option>
            {%- endfor -%}
          </select>
        </label>
      {%- endif -%}
    {%- endfor -%}
    <label class="toolbar__field">
      <span class="toolbar__label">{{ 'collection.sort_by' | t }}</span>
      <select name="sort_by">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </label>
    <noscript><button type="submit" class="button button--small">{{ 'collection.apply' | t }}</button></noscript>
  </form>

  {%- paginate collection.products by per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="grid grid--{{ section.settings.columns }}" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', card_product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="empty">{{ 'general.no_products' | t }}</p>
    {%- endif -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 48, "step": 4, "default": 12 },
    { "type": "select", "id": "columns", "label": "Columns", "default": "4", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] }
  ]
}
{% endschema %}
