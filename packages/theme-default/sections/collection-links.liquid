<div class="page-width section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  {%- if section.settings.heading != blank -%}<div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
  <ul class="collection-links collection-links--{{ section.settings.layout }} collection-links--{{ section.settings.align }}" role="list">
    {%- if section.blocks.size == 0 -%}
      {%- for collection in collections limit: 6 -%}
        <li>{% render 'collection-link', link_collection: collection, layout: section.settings.layout %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <li {{ block.shopify_attributes }}>{% render 'collection-link', link_collection: block.settings.collection, label: block.settings.label, image: block.settings.image, layout: section.settings.layout %}</li>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.collection_links.name",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_links.settings.heading",
      "default": "Shop by collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collection_links.settings.layout",
      "options": [
        {
          "value": "spotlight",
          "label": "t:sections.collection_links.options.layout.spotlight"
        },
        {
          "value": "pills",
          "label": "t:sections.collection_links.options.layout.pills"
        },
        {
          "value": "list",
          "label": "t:sections.collection_links.options.layout.list"
        }
      ],
      "default": "spotlight"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.collection_links.settings.align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.collection_links.options.align.left"
        },
        {
          "value": "center",
          "label": "t:sections.collection_links.options.align.center"
        }
      ],
      "default": "center",
      "variant": "segmented"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:sections.collection_links.blocks.link.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_links.blocks.link.settings.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.collection_links.blocks.link.settings.label",
          "info": "t:sections.collection_links.blocks.link.info.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_links.blocks.link.settings.image",
          "info": "t:sections.collection_links.blocks.link.info.image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_links.presets.collection_links",
      "category": "collection"
    }
  ]
}
{% endschema %}
