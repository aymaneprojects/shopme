<div class="page-width section-pad {% render 'scheme-class', scheme: section.settings.color_scheme %}">
  {%- if section.settings.heading != blank -%}<div class="section-head"><h2 class="section-title">{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
  <ul class="multicolumn multicolumn--{{ section.settings.columns }} multicolumn--{{ section.settings.align }}" role="list">
    {%- for block in section.blocks -%}
      <li class="multicolumn__item" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}<div class="multicolumn__media">{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}</div>{%- endif -%}
        {%- if block.settings.title != blank -%}<h3 class="multicolumn__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
        {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
        {%- if block.settings.link_label != blank -%}<a class="link-arrow" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.link_label | escape }}</a>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:sections.multicolumn.settings.columns",
      "options": [
        {
          "value": "2",
          "label": "t:sections.multicolumn.options.columns.2"
        },
        {
          "value": "3",
          "label": "t:sections.multicolumn.options.columns.3"
        },
        {
          "value": "4",
          "label": "t:sections.multicolumn.options.columns.4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:sections.multicolumn.settings.align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.options.align.left"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.options.align.center"
        }
      ],
      "default": "left",
      "variant": "segmented"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title",
          "default": "Column heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text",
          "default": "<p>Describe this column.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.presets.multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ],
      "category": "text"
    }
  ]
}
{% endschema %}
