<div class="page-width section-pad rich-text rich-text--{{ section.settings.align }}">
  <div class="rich-text__inner">
    {%- content_for 'blocks' -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "Rich text",
      "blocks": {
        "heading": { "type": "heading", "settings": { "text": "Our story" } },
        "text": { "type": "text", "settings": { "text": "<p>Share the story of your brand, a promotion or shipping details.</p>" } },
        "button": { "type": "button", "settings": { "label": "Learn more", "link": "/pages/about-us" } }
      },
      "block_order": ["heading", "text", "button"]
    }
  ]
}
{% endschema %}
