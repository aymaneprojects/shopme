{%- assign s = section.settings -%}
<div class="page-width section-pad customer {% render 'scheme-class', scheme: s.color_scheme %}">
  <div class="customer-shell">
    {% render 'account-nav', current: 'profile' %}
    <div class="customer-main">
  <div class="section-head">
    <h1 class="page-title">{%- if s.heading != blank -%}{{ s.heading | escape }}{%- else -%}{{ 'customer.profile.title' | t }}{%- endif -%}</h1>
    <a class="link-arrow" href="{{ routes.account_url }}">{{ 'customer.addresses.back' | t }}</a>
  </div>
  {%- if s.text != blank -%}<div class="rte customer__intro">{{ s.text }}</div>{%- endif -%}

  <section class="customer__profile" aria-labelledby="profile-name">
    <h2 id="profile-name">{{ customer.name | escape }}</h2>
    <dl class="customer__contact">
      <div><dt>{{ 'customer.email' | t }}</dt><dd>{{ customer.email | escape }}</dd></div>
      {%- if customer.phone != blank -%}<div><dt>{{ 'customer.profile.phone' | t }}</dt><dd>{{ customer.phone | escape }}</dd></div>{%- endif -%}
    </dl>
  </section>
  <h2 class="customer__subtitle" id="addresses-title">{{ 'customer.addresses.title' | t }}</h2>

  <details class="customer__details"{% if form.errors %} open{% endif %}>
    <summary class="button button--outline">{{ 'customer.addresses.add' | t }}</summary>
    {%- form 'customer_address', customer.new_address, class: 'customer__form', id: 'address-new' -%}
      {%- if form.errors -%}
        <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      {% render 'address-fields', address: customer.new_address, uid: 'new' %}
      <div class="customer__actions"><button class="button" type="submit">{{ 'customer.addresses.save' | t }}</button></div>
    {%- endform -%}
  </details>

  {%- if customer.addresses_count == 0 -%}
    <p class="empty">{{ 'customer.addresses.none' | t }}</p>
  {%- else -%}
    <ul class="grid grid--{{ s.columns | default: 3 }} customer__addresses" role="list">
      {%- for address in customer.addresses -%}
        <li class="customer__address">
          {%- if address.id == customer.default_address.id -%}<p class="badge">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
          <p>{{ address.name | escape }}<br>
            {%- if address.company != blank %}{{ address.company | escape }}<br>{% endif -%}
            {{ address.street | escape }}<br>{{ address.zip | escape }} {{ address.city | escape }}<br>{{ address.country | escape }}</p>
          <details class="customer__details">
            <summary class="button button--outline button--small">{{ 'customer.addresses.edit' | t }}</summary>
            {%- form 'customer_address', address, class: 'customer__form', id: 'address-edit' -%}
              {% render 'address-fields', address: address, uid: address.id %}
              <div class="customer__actions"><button class="button" type="submit">{{ 'customer.addresses.save' | t }}</button></div>
            {%- endform -%}
          </details>
          <form method="post" action="/account/addresses/{{ address.id }}" data-confirm="{{ 'customer.addresses.confirm_delete' | t }}">
            <input type="hidden" name="_method" value="delete">
            <button class="link-button" type="submit">{{ 'customer.addresses.delete' | t }}</button>
          </form>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_addresses.name",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "t:sections.customer.headers.content" },
    { "type": "text", "id": "heading", "label": "t:sections.customer.settings.heading", "info": "t:sections.customer.info.heading" },
    { "type": "richtext", "id": "text", "label": "t:sections.customer.settings.text" },
    { "type": "header", "content": "t:sections.customer.headers.layout" },
    { "type": "select", "id": "columns", "label": "t:sections.customer.settings.columns", "variant": "segmented", "default": "3", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ] },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:shared.color_scheme", "default": "" }
  ]
}
{% endschema %}
