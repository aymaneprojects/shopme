<div class="page-width page-width--narrow section-pad customer">
  <h1 class="page-title">{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password', class: 'customer__form' -%}
    {%- if form.errors -%}
      <div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="field">
      <label for="ResetPassword">{{ 'customer.password' | t }}</label>
      <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" minlength="8" required>
    </div>
    <div class="field">
      <label for="ResetPasswordConfirmation">{{ 'customer.password_confirmation' | t }}</label>
      <input id="ResetPasswordConfirmation" type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="8" required>
    </div>
    <div class="customer__actions"><button class="button" type="submit">{{ 'customer.reset.submit' | t }}</button></div>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Reset password", "tag": "section", "settings": [] }
{% endschema %}
