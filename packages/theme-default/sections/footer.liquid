{%- assign menu = section.settings.menu -%}
<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__name">{{ shop.name | escape }}</p>
      {%- if section.settings.show_description and shop.description != blank -%}
        <p class="site-footer__text">{{ shop.description | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__newsletter">
        <p class="site-footer__name">{{ 'newsletter.title' | t }}</p>
        {%- form 'customer', id: 'newsletter-form', class: 'newsletter' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}<div class="form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="newsletter-email">{{ 'newsletter.label' | t }}</label>
            <div class="newsletter__row">
              <input id="newsletter-email" class="search-form__input" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required>
              <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
    {%- if menu != blank and menu.links.size > 0 -%}
      <nav aria-label="{{ 'footer.menu' | t }}">
        <ul class="site-footer__links">
          {%- for link in menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
  <div class="page-width site-footer__legal">
    {%- assign year = 'now' | date: '%Y' -%}
    <p>{{ 'general.copyright' | t: year: year, shop: shop.name }}</p>
    <p>{{ 'general.powered_by' | t }}</p>
    <p class="site-footer__privacy">
      {%- if privacy.banner_enabled %}<a href="#cookie-preferences" data-consent-open>{{ 'privacy.footer.cookie_preferences' | t }}</a>{% endif -%}
      {%- if privacy.data_sale_opt_out_url != blank %}<a href="{{ privacy.data_sale_opt_out_url }}">{{ 'privacy.footer.opt_out' | t }}</a>{% endif -%}
    </p>
    {%- render 'language-selector' -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "footer-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
    { "type": "checkbox", "id": "show_description", "label": "Show store description", "default": true },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter sign-up", "default": true }
  ]
}
{% endschema %}
