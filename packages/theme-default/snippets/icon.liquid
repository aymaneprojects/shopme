{%- doc -%}
  Inline SVG icon.
  @param {string} name - cart | search | user | menu | close | plus | minus | chevron-down | check
{%- enddoc -%}
{%- case name -%}
  {%- when 'cart' -%}
    <svg class="icon" width="{{ settings.icon_size | default: 22 }}" height="{{ settings.icon_size | default: 22 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 7h12l-1 12H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
  {%- when 'search' -%}
    <svg class="icon" width="{{ settings.icon_size | default: 22 }}" height="{{ settings.icon_size | default: 22 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  {%- when 'user' -%}
    <svg class="icon" width="{{ settings.icon_size | default: 22 }}" height="{{ settings.icon_size | default: 22 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.5-5.5 7-5.5s6.2 1.9 7 5.5"/></svg>
  {%- when 'menu' -%}
    <svg class="icon" width="{{ settings.icon_size | default: 22 }}" height="{{ settings.icon_size | default: 22 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'close' -%}
    <svg class="icon" width="{{ settings.icon_size | default: 22 }}" height="{{ settings.icon_size | default: 22 }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ settings.icon_stroke_width | default: 1.8 }}" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg>
  {%- when 'plus' -%}
    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>
  {%- when 'minus' -%}
    <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg>
  {%- when 'check' -%}
    <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 5 5 9-10"/></svg>
{%- endcase -%}
