{%- doc -%}
  Product card used in grids.
  @param {product} card_product - the product to show
  @param {string} [sizes] - image sizes attribute
{%- enddoc -%}
{%- liquid
  assign image = card_product.featured_image
  assign focal = ''
  if image.presentation.focal_point != blank
    assign focal = 'object-position: ' | append: image.presentation.focal_point
  endif
  assign sizes_attr = sizes | default: '(min-width: 990px) 25vw, (min-width: 600px) 33vw, 50vw'
-%}
<article class="card card--align-{{ settings.card_text_align | default: 'left' }}">
  <a class="card__media" href="{{ card_product.url }}" tabindex="-1" aria-hidden="true">
    {%- if image -%}
      {{ image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '240, 360, 480, 640', sizes: sizes_attr, alt: card_product.title, style: focal }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'card__placeholder' }}
    {%- endif -%}
    {%- unless card_product.available -%}
      {%- if settings.badge_show_sold_out != false -%}
        <span class="badge badge--sold-out badge--{{ settings.badge_position | default: 'top-left' }} badge--{{ settings.badge_shape | default: 'pill' }}">{{ 'products.sold_out' | t }}</span>
      {%- endif -%}
    {%- elsif card_product.compare_at_price > card_product.price and settings.badge_show_sale != false -%}
      <span class="badge badge--sale badge--{{ settings.badge_position | default: 'top-left' }} badge--{{ settings.badge_shape | default: 'pill' }}">
        {%- if settings.badge_sale_percent -%}
          {%- assign saved = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
          -{{ saved }}%
        {%- else -%}
          {{ 'products.sale' | t }}
        {%- endif -%}
      </span>
    {%- endunless -%}
  </a>
  <div class="card__body">
    {%- if settings.show_vendor and card_product.vendor != blank -%}
      <p class="card__vendor">{{ card_product.vendor }}</p>
    {%- endif -%}
    <h3 class="card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    {% render 'price', product: card_product %}
  </div>
</article>
