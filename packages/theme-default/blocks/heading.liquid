<h2 {% render 'block-attrs', block: block, class: 'section-title' %} {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>

{% schema %}
{
  "name": "t:blocks.heading.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:blocks.heading.settings.text",
      "default": "Heading"
    },
    {
      "type": "header",
      "content": "t:shared.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:shared.width",
      "default": "fit",
      "variant": "segmented",
      "options": [
        {
          "value": "fit",
          "label": "t:shared.width_fit"
        },
        {
          "value": "fill",
          "label": "t:shared.width_fill"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:shared.max_width",
      "info": "t:shared.max_width_info",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.typography"
    },
    {
      "type": "select",
      "id": "text_preset",
      "label": "t:shared.text_preset",
      "default": "h2",
      "options": [
        {
          "value": "paragraph",
          "label": "t:shared.preset.paragraph"
        },
        {
          "value": "h1",
          "label": "t:shared.preset.h1"
        },
        {
          "value": "h2",
          "label": "t:shared.preset.h2"
        },
        {
          "value": "h3",
          "label": "t:shared.preset.h3"
        },
        {
          "value": "h4",
          "label": "t:shared.preset.h4"
        },
        {
          "value": "h5",
          "label": "t:shared.preset.h5"
        },
        {
          "value": "h6",
          "label": "t:shared.preset.h6"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:shared.text_color",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "t:shared.show_background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:shared.background_color",
      "default": "#f1f5f9",
      "visible_if": "{{ block.settings.show_background }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.padding_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.presets.heading"
    }
  ]
}
{% endschema %}
