{%- if block.settings.label != blank -%}
  <div {% render 'block-attrs', block: block, class: 'block-button' %} {{ block.shopify_attributes }}>
    <a class="button{% if block.settings.style == 'outline' %} button--outline{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}"{% if block.settings.open_new_tab %} target="_blank" rel="noopener"{% endif %}>{{ block.settings.label | escape }}</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button.settings.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button.settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab",
      "label": "t:blocks.button.settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button.settings.style",
      "options": [
        {
          "value": "solid",
          "label": "t:blocks.button.options.style.solid"
        },
        {
          "value": "outline",
          "label": "t:blocks.button.options.style.outline"
        }
      ],
      "default": "solid",
      "variant": "segmented"
    },
    {
      "type": "header",
      "content": "t:shared.layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:shared.width",
      "default": "fit",
      "variant": "segmented",
      "options": [
        {
          "value": "fit",
          "label": "t:shared.width_fit"
        },
        {
          "value": "fill",
          "label": "t:shared.width_fill"
        }
      ]
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "t:shared.max_width",
      "info": "t:shared.max_width_info",
      "min": 0,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:shared.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:shared.color_scheme",
      "default": ""
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:shared.text_color",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "show_background",
      "label": "t:shared.show_background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:shared.background_color",
      "default": "#f1f5f9",
      "visible_if": "{{ block.settings.show_background }}"
    },
    {
      "type": "header",
      "content": "t:shared.spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:shared.padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:shared.padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:shared.padding_left",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:shared.padding_right",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button.presets.button"
    }
  ]
}
{% endschema %}
