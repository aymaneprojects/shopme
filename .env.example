# ---------------------------------------------------------------------------
# ShopMe server configuration. Copy to .env. Every variable is optional for local use.
# ---------------------------------------------------------------------------
PORT=3000
# Public URL of the site (used for links, cookies' Secure flag, CSRF origin check).
APP_URL=http://localhost:3000
# PostgreSQL connection string. Leave empty to use the embedded database (PGlite) in DATA_DIR/pglite.
DATABASE_URL=
# Where ShopMe keeps its files (embedded database, uploads, generated session secret).
DATA_DIR=./data
# At least 32 random characters. If empty, one is generated and stored in DATA_DIR/session-secret.
SESSION_SECRET=
# Uploads directory (default: DATA_DIR/uploads).
STORAGE_DIR=
# Outgoing email. By default each store sends directly from this server, signed with DKIM (see docs/install/email.md).
# SMTP_URL is the installation-wide fallback relay, e.g. smtp://user:pass@smtp.example.com:587; stores can still choose
# direct sending or their own relay in Settings > E-mails.
SMTP_URL=
MAIL_FROM=
# Public IP of this server, used in the SPF line (IPv4, optionally IPv6, comma separated). Detected through DNS when empty.
PUBLIC_IP=
# Set to true only for local development: lets SMTP relays and MX hosts be on private or loopback addresses.
EMAIL_ALLOW_PRIVATE_HOSTS=
# Off-site backups (Settings > Backup). true lets the bucket be on a private or loopback address (a local MinIO). Default false.
BACKUP_ALLOW_PRIVATE_ENDPOINTS=
# pg_dump binary for the database dump sent with off-site backups (default: pg_dump from the PATH, when there is one).
PG_DUMP_PATH=
# Stripe (optional, used by checkout).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only for local development: lets outbound webhooks call loopback/private addresses (SSRF guard otherwise).
WEBHOOKS_ALLOW_PRIVATE=
# Set to true behind a reverse proxy (Caddy, nginx) so X-Forwarded-* headers are trusted.
TRUST_PROXY=false
# Extra origins allowed to send cookie-authenticated POSTs, comma separated (e.g. a Vite dev server).
TRUSTED_ORIGINS=
# Send Strict-Transport-Security (only effective when APP_URL is https). true | false
HSTS=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Multi-store mode. One installation, several stores: accounts, a store switcher, "Create a store", each store on its own host.
# See docs/install/multi-store.md. On by default in Docker and server installs (the installer, docker-compose.yml);
# `pnpm dev` and the desktop app stay single-store. Set MULTI_STORE=false for a plain single store. An existing single
# store becomes the account's first store.
# ---------------------------------------------------------------------------
# true | false (Docker and the installer: true when unset; plain `node`: false)
# MULTI_STORE=true
# Each store answers on <handle>.<STORE_BASE_DOMAIN> (one wildcard A record: *.<STORE_BASE_DOMAIN>).
# Default: the host of APP_URL, so a server installed for boutique.fr gives new stores <handle>.boutique.fr.
STORE_BASE_DOMAIN=
# Host of the platform admin (default: the host of APP_URL). Comma separated for several.
# When it equals STORE_BASE_DOMAIN (the default), the first store's storefront is served on that same domain.
ADMIN_HOST=
# Secret of the local GET /__shopme/hosts endpoint read by `shopme-install.sh sync-certs` (nginx installs). At least 16 characters.
HOSTS_TOKEN=
# Passkeys (WebAuthn) need no setting of their own: they are bound to the admin host (the host of APP_URL, or the first ADMIN_HOST in
# multi-store mode) and need HTTPS. Changing that host later means passkeys must be added again. See docs/install/sign-in.md.

# ---------------------------------------------------------------------------
# Only used by the reverse-engineering scripts in scripts/re/ (not by the server).
# Use credentials of your OWN development store only. Never commit real values.
# ---------------------------------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STOREFRONT_PASSWORD=
RE_OUT=
API_VERSION=2026-10
