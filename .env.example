# ---------------------------------------------------------------------------
# ShopMe server configuration. Copy to .env. Every variable is optional for local use.
# ---------------------------------------------------------------------------
PORT=3000
# Public URL of the site (used for links, cookies' Secure flag, CSRF origin check).
APP_URL=http://localhost:3000
# PostgreSQL connection string. Leave empty to use the embedded database (PGlite) in DATA_DIR/pglite.
DATABASE_URL=
# Where ShopMe keeps its files (embedded database, uploads, generated session secret).
DATA_DIR=./data
# At least 32 random characters. If empty, one is generated and stored in DATA_DIR/session-secret.
SESSION_SECRET=
# Uploads directory (default: DATA_DIR/uploads).
STORAGE_DIR=
# Outgoing email, e.g. smtp://user:pass@smtp.example.com:587. If empty, emails are only logged to the console.
SMTP_URL=
MAIL_FROM=
# Stripe (optional, used by checkout).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to 1 only for local development: lets outbound webhooks call loopback/private addresses (SSRF guard otherwise).
WEBHOOKS_ALLOW_PRIVATE=
# Set to true behind a reverse proxy (Caddy, nginx) so X-Forwarded-* headers are trusted.
TRUST_PROXY=false
# Extra origins allowed to send cookie-authenticated POSTs, comma separated (e.g. a Vite dev server).
TRUSTED_ORIGINS=
# Send Strict-Transport-Security (only effective when APP_URL is https). true | false
HSTS=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Multi-store mode (off by default). One installation, several stores: accounts, a store switcher, "Create a store",
# each store on its own host. See docs/install/multi-store.md. An existing single store becomes the account's first store.
# ---------------------------------------------------------------------------
# true | false
MULTI_STORE=false
# Each store answers on <handle>.<STORE_BASE_DOMAIN> (needs a wildcard DNS record). Default: localhost (<handle>.localhost).
STORE_BASE_DOMAIN=
# Host of the platform admin (default: the host of APP_URL). Comma separated for several. Never one of the stores' hosts.
ADMIN_HOST=

# ---------------------------------------------------------------------------
# Only used by the reverse-engineering scripts in scripts/re/ (not by the server).
# Use credentials of your OWN development store only. Never commit real values.
# ---------------------------------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STOREFRONT_PASSWORD=
RE_OUT=
API_VERSION=2026-10
