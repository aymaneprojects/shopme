{
  "name": "@shopme/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "lint": "echo \"no lint yet\"",
    "test": "vitest run",
    "test:multi": "vitest run --config vitest.multistore.config.ts",
    "test:isolation": "vitest run src/multistore.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1163.0",
    "@aws-sdk/lib-storage": "3.1163.0",
    "@electric-sql/pglite": "0.5.15",
    "@fastify/cookie": "11.1.2",
    "@fastify/multipart": "10.1.3",
    "@fastify/static": "10.1.10",
    "@node-rs/argon2": "2.2.1",
    "@pothos/core": "4.16.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "graphql": "16.14.2",
    "graphql-yoga": "6.0.1",
    "liquidjs": "10.30.1",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "postgres": "3.4.8",
    "qrcode": "1.5.4",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@shopme/core": "workspace:*",
    "@shopme/liquid-compat": "workspace:^",
    "@shopme/migrate": "workspace:*",
    "@shopme/payments": "workspace:*",
    "@shopme/shopify-compat": "workspace:*",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.14",
    "vitest": "5.1.0"
  }
}
